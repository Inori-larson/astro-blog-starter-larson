{
	"name": "larson-blog",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "larson-blog-db",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "0000000000000000000000000000cache"
		},
		{
			"binding": "SESSION",
			"id": "0000000000000000000000000000session"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
