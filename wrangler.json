{
	"name": "larson-blog",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "larson-blog-db",
			"database_id": "e0d0602f-294b-4507-9f76-399ecf604be0"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "larson-blog-media"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "418e2f6b9c844fe684ec6af033c6dcb1"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"upload_source_maps": true
}
