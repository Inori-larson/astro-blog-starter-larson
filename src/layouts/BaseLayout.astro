---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import BackToTop from '../components/BackToTop.astro';
import WorldDecor from '../components/WorldDecor.astro';
import { ClientRouter } from 'astro:transitions';
import { getDb } from '../lib/db';
import { getSiteSettings } from '../lib/settings';

interface Props {
	/** 页面标题（不含站点后缀，由布局统一拼接「页面 · 站点标题」；首页留空） */
	title?: string;
	description: string;
	image?: string;
	/** 额外注入到 body 之后的页面元素（如阅读进度条） */
	class?: string;
}

const { title, description, image, class: className } = Astro.props;

const db = getDb(Astro);
const site = await getSiteSettings(Astro, db);
const fullTitle = title ? `${title} · ${site.siteTitle}` : site.siteTitle;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={fullTitle} description={description} image={image} />
		<ClientRouter />
	</head>
	<body class:list={['relative flex min-h-screen flex-col', className]}>
		<WorldDecor />
		<div class="relative z-10 flex min-h-screen flex-col">
			<Header site={site} />
			<main class="flex-1">
				<slot />
			</main>
			<Footer site={site} />
		</div>
		<BackToTop />
		<SearchModal />

		<script>
			// 滚动渐入：软导航后重新绑定观察器
			const initReveal = () => {
				const els = document.querySelectorAll('.reveal:not(.is-visible)');
				if (!els.length) return;
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								io.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
				);
				els.forEach((el) => io.observe(el));
			};

			// 点击特效：浅色=水花波纹，暗色=魔术火花（自动跟随主题）
			// 模块级监听器只注册一次，软导航不重复挂载
			let clickFxBound = false;
			const initClickFx = () => {
				if (clickFxBound) return;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				clickFxBound = true;
				document.addEventListener('pointerdown', (e) => {
					if (e.button !== 0) return;
					// 避免在输入框/按钮密集区过多干扰：仅装饰，不拦截
					const fx = document.createElement('span');
					fx.className = 'click-fx';
					fx.style.left = `${e.clientX}px`;
					fx.style.top = `${e.clientY}px`;
					document.body.appendChild(fx);
					setTimeout(() => fx.remove(), 600);
				});
			};

			document.addEventListener('astro:page-load', () => {
				initReveal();
				initClickFx();
			});
		</script>
	</body>
</html>
