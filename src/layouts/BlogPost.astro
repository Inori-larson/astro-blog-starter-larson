---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TOC from '../components/TOC.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { SITE_TITLE } from '../consts';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface RelatedPost {
	title: string;
	href: string;
	readingTime?: number;
}

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	tags?: string[];
	headings?: Heading[];
	readingTime?: number;
	prev?: { title: string; href: string };
	next?: { title: string; href: string };
	related?: RelatedPost[];
}

const { title, description, pubDate, updatedDate, heroImage, tags = [], headings = [], readingTime, prev, next, related } =
	Astro.props;

const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();
const xShare = `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(title)}`;
const weiboShare = `https://service.weibo.com/share/share.php?url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent(title)}`;
---

<BaseLayout title={`${title} · ${SITE_TITLE}`} description={description} image={heroImage}>
	<ReadingProgress />

	<article class="mx-auto w-full max-w-6xl px-4 pt-12 pb-16 sm:px-6">
		<!-- 文章头部 -->
		<header class="mx-auto max-w-3xl">
			{
				tags.length > 0 && (
					<div class="flex flex-wrap justify-center gap-2">
						{tags.map((tag) => (
							<a
								href={`/tags/${encodeURIComponent(tag)}`}
								class="rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-medium text-zinc-500 transition-all hover:border-brand-400 hover:text-brand-600 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-brand-500 dark:hover:text-brand-400"
							>
								{tag}
							</a>
						))}
					</div>
				)
			}

			<h1
				class="mt-5 text-center text-3xl leading-tight font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white"
			>
				{title}
			</h1>

			<div
				class="mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm text-zinc-400 dark:text-zinc-500"
			>
				<span class="flex items-center gap-1.5">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="h-4 w-4"
						aria-hidden="true"
					>
						<rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
						<line x1="16" x2="16" y1="2" y2="6" />
						<line x1="8" x2="8" y1="2" y2="6" />
						<line x1="3" x2="21" y1="10" y2="10" />
					</svg>
					<FormattedDate date={pubDate} />
				</span>
				{
					readingTime && (
						<span class="flex items-center gap-1.5">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="h-4 w-4"
								aria-hidden="true"
							>
								<circle cx="12" cy="12" r="10" />
								<polyline points="12 6 12 12 16 14" />
							</svg>
							约 {readingTime} 分钟
						</span>
					)
				}
			</div>

			{
				updatedDate && (
					<p class="mt-2 text-center text-xs italic text-zinc-400 dark:text-zinc-600">
						最后更新于 <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>

		<!-- 头图 -->
		{
			heroImage && (
				<div class="reveal mx-auto mt-10 max-w-4xl">
					<img
						src={heroImage}
						alt=""
						width={1020}
						height={510}
						loading="eager"
						fetchpriority="high"
						class="aspect-2/1 w-full rounded-2xl border border-zinc-200/60 object-cover shadow-lg shadow-zinc-900/5 dark:border-zinc-800"
					/>
				</div>
			)
		}

		<!-- 正文 + 目录 -->
		<div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:max-w-5xl">
			<div class="prose prose-zinc reveal dark:prose-invert min-w-full lg:min-w-0">
				<slot />
			</div>
			<aside class="hidden lg:block">
				<div class="sticky top-24">
					<TOC headings={headings} />
				</div>
			</aside>
		</div>

		<!-- 分享栏 -->
		<div
			class="mx-auto mt-12 flex max-w-3xl flex-col items-center justify-between gap-4 rounded-2xl border border-zinc-200/70 bg-white/60 px-5 py-4 sm:flex-row dark:border-zinc-800/70 dark:bg-zinc-900/60"
		>
			<span class="text-sm font-medium text-zinc-600 dark:text-zinc-300">
				觉得有帮助？分享给更多人
			</span>
			<div class="flex items-center gap-2">
				<button
					id="copy-link"
					type="button"
					class="inline-flex h-9 items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-4 text-xs font-semibold text-zinc-600 transition-all hover:border-brand-400 hover:text-brand-600 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-brand-500 dark:hover:text-brand-400"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="h-3.5 w-3.5"
						aria-hidden="true"
					>
						<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
						<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
					</svg>
					<span>复制链接</span>
				</button>
				<a
					href={xShare}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex h-9 items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-4 text-xs font-semibold text-zinc-600 transition-all hover:border-zinc-400 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-500"
				>
					<svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
						<path
							d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
						></path>
					</svg>
					<span>分享到 X</span>
				</a>
				<a
					href={weiboShare}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex h-9 items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-4 text-xs font-semibold text-zinc-600 transition-all hover:border-zinc-400 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-500"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="h-3.5 w-3.5"
						aria-hidden="true"
					>
						<path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
						<polyline points="16 6 12 2 8 6"></polyline>
						<line x1="12" x2="12" y1="2" y2="15"></line>
					</svg>
					<span>微博</span>
				</a>
			</div>
		</div>

		<!-- 相关文章 -->
		{
			related && related.length > 0 && (
				<section class="mx-auto mt-14 max-w-3xl">
					<h2 class="text-lg font-bold text-zinc-900 dark:text-white">相关文章</h2>
					<ul class="mt-4 space-y-1.5">
						{related.map((r) => (
							<li>
								<a
									href={r.href}
									class="group flex items-center gap-3 rounded-xl border border-zinc-200/70 bg-white/60 px-4 py-3 transition-all hover:border-brand-300/60 hover:bg-white hover:shadow-md hover:shadow-brand-500/5 dark:border-zinc-800/70 dark:bg-zinc-900/60 dark:hover:border-brand-500/40 dark:hover:bg-zinc-900"
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0 text-zinc-300 group-hover:text-brand-500 dark:text-zinc-600" aria-hidden="true">
										<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
										<polyline points="14 2 14 8 20 8" />
										<line x1="16" x2="8" y1="13" y2="13" />
										<line x1="16" x2="8" y1="17" y2="17" />
									</svg>
									<span class="flex-1 truncate text-sm font-medium text-zinc-700 group-hover:text-brand-600 dark:text-zinc-300 dark:group-hover:text-brand-400">
										{r.title}
									</span>
									{r.readingTime && (
										<span class="shrink-0 text-xs text-zinc-400 dark:text-zinc-600">{r.readingTime} 分钟</span>
									)}
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<!-- 上一篇 / 下一篇 -->
		{
			(prev || next) && (
				<nav class="mx-auto mt-10 grid max-w-3xl gap-4 sm:grid-cols-2" aria-label="文章导航">
					{prev ? (
						<a
							href={prev.href}
							class="group flex flex-col gap-1 rounded-2xl border border-zinc-200/80 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-brand-300/60 hover:shadow-lg hover:shadow-brand-500/10 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-brand-500/40"
						>
							<span class="flex items-center gap-1.5 text-xs font-medium text-zinc-400 dark:text-zinc-500">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
								上一篇
							</span>
							<span class="line-clamp-2 font-semibold text-zinc-900 transition-colors group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400">
								{prev.title}
							</span>
						</a>
					) : (
						<span />
					)}
					{next && (
						<a
							href={next.href}
							class="group flex flex-col items-end gap-1 rounded-2xl border border-zinc-200/80 bg-white p-5 text-right transition-all hover:-translate-y-0.5 hover:border-brand-300/60 hover:shadow-lg hover:shadow-brand-500/10 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-brand-500/40"
						>
							<span class="flex items-center gap-1.5 text-xs font-medium text-zinc-400 dark:text-zinc-500">
								下一篇
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
							</span>
							<span class="line-clamp-2 font-semibold text-zinc-900 transition-colors group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400">
								{next.title}
							</span>
						</a>
					)}
				</nav>
			)
		}
	</article>
</BaseLayout>

<script>
	// ===== 代码块：注入语言标签与复制按钮 =====
	const setupCodeBlocks = () => {
		document.querySelectorAll('pre').forEach((pre) => {
			if (pre.querySelector('.code-copy')) return;

			const lang = [...pre.classList]
				.find((c) => c.startsWith('language-'))
				?.replace('language-', '') ?? '';

			if (lang) {
				const label = document.createElement('span');
				label.className = 'code-lang';
				label.textContent = lang;
				pre.appendChild(label);
			}

			const btn = document.createElement('button');
			btn.className = 'code-copy';
			btn.type = 'button';
			btn.textContent = '复制';
			btn.addEventListener('click', async () => {
				const code = pre.querySelector('code')?.innerText ?? '';
				try {
					await navigator.clipboard.writeText(code);
					btn.textContent = '已复制 ✓';
					btn.classList.add('copied');
				} catch {
					btn.textContent = '复制失败';
				}
				setTimeout(() => {
					btn.textContent = '复制';
					btn.classList.remove('copied');
				}, 2000);
			});
			pre.appendChild(btn);
		});
	};

	// ===== 目录：滚动时高亮当前章节 =====
	const setupTocHighlight = () => {
		const links = document.querySelectorAll('[data-toc-link]');
		if (!links.length) return;

		const setActive = (slug: string) => {
			links.forEach((link) => {
				const active = link.getAttribute('data-toc-link') === slug;
				link.classList.toggle('text-brand-600', active);
				link.classList.toggle('dark:text-brand-400', active);
				link.classList.toggle('border-brand-500', active);
				link.classList.toggle('text-zinc-400', !active);
				link.classList.toggle('dark:text-zinc-500', !active);
			});
		};

		const headings = [...document.querySelectorAll('h2, h3')]
			.filter((h) => h.id)
			.map((h) => ({ id: h.id, top: h.getBoundingClientRect().top + window.scrollY }));

		if (!headings.length) return;

		const onScroll = () => {
			const pos = window.scrollY + 96;
			let current = headings[0]!.id;
			for (const h of headings) {
				if (h.top <= pos) current = h.id;
			}
			setActive(current);
		};
		window.removeEventListener('scroll', onScroll);
		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
	};

	// ===== 复制文章链接 =====
	const setupCopyLink = () => {
		const btn = document.getElementById('copy-link');
		btn?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);
				const label = btn.querySelector('span');
				if (label) {
					const original = label.textContent;
					label.textContent = '已复制 ✓';
					setTimeout(() => {
						label.textContent = original;
					}, 2000);
				}
			} catch {
				/* 剪贴板不可用时静默失败 */
			}
		});
	};

	document.addEventListener('astro:page-load', () => {
		setupCodeBlocks();
		setupTocHighlight();
		setupCopyLink();
	});
</script>
