---
// 阅读进度条：固定在页面顶部，随滚动填充渐变色
---

<div
	id="reading-progress"
	class="fixed inset-x-0 top-0 z-50 h-[3px] bg-transparent"
	aria-hidden="true"
>
	<div
		id="reading-progress-bar"
		class="h-full w-0 bg-gradient-to-r from-brand-500 via-violet-500 to-fuchsia-500"
	>
	</div>
</div>

<script>
	const initProgress = () => {
		const bar = document.getElementById('reading-progress-bar');
		if (!bar) return;

		let ticking = false;
		const update = () => {
			const scrollTop = window.scrollY;
			const docHeight = document.documentElement.scrollHeight - window.innerHeight;
			const progress = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
			bar.style.width = `${progress * 100}%`;
			ticking = false;
		};
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};

		window.removeEventListener('scroll', onScroll);
		window.addEventListener('scroll', onScroll, { passive: true });
		update();
	};
	document.addEventListener('astro:page-load', initProgress);
</script>
