---
import { STATUS_LABELS, type ProjectStatus } from '../data/projects';

interface Props {
	status: ProjectStatus;
}

const { status } = Astro.props;

const DOT: Record<ProjectStatus, string> = {
	active: 'bg-emerald-500',
	maintained: 'bg-sky-500',
	finished: 'bg-violet-500',
	planned: 'bg-amber-500',
};
---

<span
	class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200/80 bg-white/70 px-2.5 py-0.5 text-xs font-medium text-zinc-500 dark:border-zinc-700 dark:bg-zinc-900/70 dark:text-zinc-400"
>
	<span class:list={['relative flex h-1.5 w-1.5 rounded-full', DOT[status]]} aria-hidden="true">
		{
			status === 'active' && (
				<span
					class:list={['absolute inline-flex h-full w-full animate-ping rounded-full opacity-75', DOT[status]]}
				/>
			)
		}
	</span>
	{STATUS_LABELS[status]}
</span>
