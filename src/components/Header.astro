---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';

const links = [
	{ href: '/', label: '首页' },
	{ href: '/blog', label: '博客' },
	{ href: '/archive', label: '归档' },
	{ href: '/tags', label: '标签' },
	{ href: '/projects', label: '项目' },
	{ href: '/about', label: '关于' },
];

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const firstSegment = '/' + (subpath?.[0] || '');
---

<header
	id="site-header"
	class="sticky top-0 z-40 border-b border-zinc-200/70 bg-zinc-50/80 backdrop-blur-xl transition-transform duration-300 ease-out dark:border-zinc-800/70 dark:bg-zinc-950/80"
>
	<nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
		<a href="/" class="group flex items-center gap-2.5">
			<span
				class="flex h-8 w-8 items-center justify-center rounded-lg text-sm font-bold text-white shadow-lg transition-transform duration-300 group-hover:scale-105 group-hover:rotate-3 bg-gradient-to-br from-brand-500 via-sky-400 to-cyan-300 shadow-brand-500/25 dark:from-fate-gold-dark dark:via-fate-gold dark:to-fate-blood dark:shadow-fate-gold/25"
				aria-hidden="true"
			>
				L
			</span>
			<span class="text-[0.95rem] font-bold text-zinc-900 dark:text-white">
				{SITE_TITLE}
			</span>
		</a>

		<!-- 桌面导航 -->
		<div class="hidden items-center gap-1 md:flex">
			{links.map((l) => <HeaderLink href={l.href}>{l.label}</HeaderLink>)}
		</div>

		<div class="flex items-center gap-1">
			<!-- 搜索按钮（宽屏胶囊样式） -->
			<button
				type="button"
				data-search-open
				class="hidden h-9 items-center gap-2 rounded-full border border-zinc-200 bg-white/60 pr-1.5 pl-3 text-sm text-zinc-400 transition-all hover:border-zinc-300 hover:text-zinc-600 lg:flex dark:border-zinc-700 dark:bg-zinc-900/60 dark:hover:border-zinc-600 dark:hover:text-zinc-300"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-4 w-4"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
				<span>搜索…</span>
				<kbd
					data-kbd-platform
					class="rounded-md border border-zinc-200 bg-zinc-50 px-1.5 py-0.5 font-mono text-[10px] text-zinc-400 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-500"
				>
					Ctrl K
				</kbd>
			</button>

			<!-- 搜索按钮（图标样式） -->
			<button
				type="button"
				data-search-open
				aria-label="搜索"
				class="inline-flex h-9 w-9 items-center justify-center rounded-full text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-900 lg:hidden dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-white"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-[1.15rem] w-[1.15rem]"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
			</button>

			<span class="mx-1 h-5 w-px bg-zinc-200 dark:bg-zinc-800" aria-hidden="true"></span>
			<ThemeToggle showLabel labelAlign="pill" />

			<!-- 移动端菜单按钮 -->
			<button
				id="mobile-menu-btn"
				type="button"
				aria-label="打开菜单"
				aria-expanded="false"
				aria-controls="mobile-menu"
				class="inline-flex h-9 w-9 items-center justify-center rounded-full text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-900 md:hidden dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-white"
			>
				<!-- 汉堡图标 -->
				<svg
					data-icon-open
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-5 w-5"
					aria-hidden="true"
				>
					<path d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
				<!-- 关闭图标 -->
				<svg
					data-icon-close
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="hidden h-5 w-5"
					aria-hidden="true"
				>
					<path d="M18 6 6 18M6 6l12 12"></path>
				</svg>
			</button>
		</div>
	</nav>

	<!-- 移动端下拉菜单（开合动画） -->
	<div
		id="mobile-menu"
		class="grid grid-rows-[0fr] overflow-hidden border-t border-transparent opacity-0 transition-all duration-300 ease-out md:hidden dark:border-transparent"
	>
		<div class="min-h-0 overflow-hidden">
			<nav
				class="mx-auto flex max-w-6xl flex-col gap-0.5 px-4 py-3 sm:px-6"
				aria-label="移动端导航"
			>
			{
				links.map((l) => {
					const isActive = l.href === pathname || l.href === firstSegment;
					return (
						<a
							href={l.href}
							class:list={[
								'flex items-center justify-between rounded-lg px-3 py-2.5 text-[15px] font-medium transition-colors',
								isActive
									? 'bg-brand-50 text-brand-600 dark:bg-amber-400/10 dark:text-amber-400'
									: 'text-zinc-600 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-zinc-900',
							]}
						>
							{l.label}
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-zinc-300 dark:text-zinc-600" aria-hidden="true">
								<path d="m9 18 6-6-6-6" />
							</svg>
						</a>
					);
				})
			}
			</nav>
		</div>
	</div>
</header>

<script>
	const initMobileMenu = () => {
		const btn = document.getElementById('mobile-menu-btn');
		const menu = document.getElementById('mobile-menu');
		if (!btn || !menu) return;

		const iconOpen = btn.querySelector('[data-icon-open]');
		const iconClose = btn.querySelector('[data-icon-close]');

		const setOpen = (open: boolean) => {
			menu.classList.toggle('grid-rows-[0fr]', !open);
			menu.classList.toggle('grid-rows-[1fr]', open);
			menu.classList.toggle('opacity-0', !open);
			menu.classList.toggle('border-transparent', !open);
			menu.classList.toggle('border-zinc-200/70', open);
			menu.classList.toggle('dark:border-zinc-800/70', open);
			iconOpen?.classList.toggle('hidden', open);
			iconClose?.classList.toggle('hidden', !open);
			btn.setAttribute('aria-expanded', String(open));
			// 菜单展开时锁定 header，避免滚动隐藏
			btn.dataset.menuOpen = String(open);
		};

		btn.addEventListener('click', () => {
			const isOpen = menu.classList.contains('grid-rows-[1fr]');
			setOpen(!isOpen);
		});
		menu.querySelectorAll('a').forEach((a) =>
			a.addEventListener('click', () => setOpen(false)),
		);
	};

	// 滚动方向感知：下滑隐藏、上滑显示（菜单展开时除外）
	const initScrollHide = () => {
		const header = document.getElementById('site-header');
		if (!header) return;

		let lastY = window.scrollY;
		let ticking = false;
		const update = () => {
			const menuBtn = document.getElementById('mobile-menu-btn');
			const menuOpen = menuBtn?.dataset.menuOpen === 'true';
			const y = window.scrollY;
			const delta = y - lastY;
			if (!menuOpen && (delta > 8 && y > 120)) {
				header.style.transform = 'translateY(-100%)';
			} else if (delta < -8 || y <= 120) {
				header.style.transform = '';
			}
			lastY = y;
			ticking = false;
		};
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};
		window.removeEventListener('scroll', onScroll);
		window.addEventListener('scroll', onScroll, { passive: true });
	};

	document.addEventListener('astro:page-load', () => {
		initMobileMenu();
		initScrollHide();
	});
</script>
