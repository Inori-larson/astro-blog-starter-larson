---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
---

<header
	class="sticky top-0 z-40 border-b border-zinc-200/70 bg-zinc-50/80 backdrop-blur-xl dark:border-zinc-800/70 dark:bg-zinc-950/80"
>
	<nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
		<a href="/" class="group flex items-center gap-2.5">
			<span
				class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-brand-500 via-violet-500 to-fuchsia-500 text-sm font-bold text-white shadow-lg shadow-brand-500/25 transition-transform duration-300 group-hover:scale-105 group-hover:rotate-3"
				aria-hidden="true"
			>
				A
			</span>
			<span class="text-[0.95rem] font-bold text-zinc-900 dark:text-white">
				{SITE_TITLE}
			</span>
		</a>

		<div class="flex items-center gap-1 sm:gap-2">
			<div class="flex items-center">
				<HeaderLink href="/">首页</HeaderLink>
				<HeaderLink href="/blog">博客</HeaderLink>
				<HeaderLink href="/about">关于</HeaderLink>
			</div>
			<span class="mx-1 h-5 w-px bg-zinc-200 dark:bg-zinc-800" aria-hidden="true"></span>
			<ThemeToggle />
		</div>
	</nav>
</header>
