---
// 页脚订阅框：输入邮箱 → 发验证邮件 → 确认后生效
---

<div id="subscribe-box" class="mt-4 max-w-xs">
	<p class="text-sm font-semibold text-zinc-900 dark:text-zinc-200">邮件订阅</p>
	<p class="mt-1 text-xs leading-relaxed text-zinc-500 dark:text-zinc-500">
		新文章发布时第一时间通知你（一封都不会多）。
	</p>
	<form id="subscribe-form" class="mt-3 flex gap-2">
		<input
			id="subscribe-email"
			type="email"
			required
			placeholder="you@example.com"
			class="h-10 min-w-0 flex-1 rounded-lg border border-zinc-200 bg-white/80 px-3 text-xs text-zinc-900 outline-none transition-colors placeholder:text-zinc-400 focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-amber-500/60"
		/>
		<button
			type="submit"
			id="subscribe-btn"
			class="h-10 shrink-0 rounded-lg bg-gradient-to-r from-brand-600 to-sky-500 px-4 text-xs font-semibold text-white shadow-md shadow-brand-500/25 transition-all hover:-translate-y-0.5 disabled:translate-y-0 disabled:opacity-60 dark:from-fate-gold-dark dark:to-fate-gold dark:shadow-fate-gold/20"
		>
			订阅
		</button>
	</form>
	<p id="subscribe-msg" class="mt-2 hidden text-xs font-medium" aria-live="polite"></p>
</div>

<script>
	const initSubscribe = () => {
		const form = document.getElementById('subscribe-form') as HTMLFormElement | null;
		if (!form) return;
		const email = document.getElementById('subscribe-email') as HTMLInputElement;
		const msg = document.getElementById('subscribe-msg')!;
		const btn = document.getElementById('subscribe-btn') as HTMLButtonElement;

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			btn.disabled = true;
			msg.classList.add('hidden');
			try {
				const res = await fetch('/api/subscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email: email.value.trim() }),
				});
				const data = await res.json();
				msg.textContent = res.ok ? String(data.message) : String(data.error ?? '订阅失败');
				msg.className = `mt-2 text-xs font-medium ${res.ok ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400'}`;
				msg.classList.remove('hidden');
				if (res.ok) email.value = '';
				setTimeout(() => msg.classList.add('hidden'), 6000);
			} catch {
				msg.textContent = '网络错误，请稍后再试';
				msg.className = 'mt-2 text-xs font-medium text-rose-600 dark:text-rose-400';
				msg.classList.remove('hidden');
			} finally {
				btn.disabled = false;
			}
		});
	};
	document.addEventListener('astro:page-load', initSubscribe);
</script>
