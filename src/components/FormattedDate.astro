---
interface Props {
	date: Date | string;
}

const { date } = Astro.props;
const d = date instanceof Date ? date : new Date(date);
---

<time datetime={d.toISOString()} class="font-medium">
	{
		d.toLocaleDateString('zh-CN', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		})
	}
</time>
