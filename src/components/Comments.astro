---
interface Props {
	slug: string;
}

const { slug } = Astro.props;
---

<section id="comments" data-slug={slug} class="mx-auto mt-14 max-w-3xl">
	<h2 class="flex items-center gap-2 text-lg font-bold text-zinc-900 dark:text-white">
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			class="h-5 w-5 text-brand-500"
			aria-hidden="true"
		>
			<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
		</svg>
		评论
		<span id="comment-total" class="text-sm font-normal text-zinc-400 dark:text-zinc-500"></span>
	</h2>

	<!-- 评论表单 -->
	<form id="comment-form" class="mt-5 rounded-2xl border border-zinc-200/80 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
		<div class="flex gap-3">
			<input id="reply-to" type="hidden" value="" />
			<div id="reply-banner" class="hidden w-full">
				<div
					class="mb-3 flex items-center justify-between rounded-lg bg-brand-50 px-3 py-2 text-xs text-brand-700 dark:bg-amber-400/10 dark:text-brand-300"
				>
					<span id="reply-banner-text"></span>
					<button
						type="button"
						id="reply-cancel"
						class="ml-2 shrink-0 font-semibold transition-opacity hover:opacity-70"
					>
						取消回复
					</button>
				</div>
			</div>
		</div>
		<div class="grid gap-3 sm:grid-cols-2">
			<input
				id="comment-name"
				type="text"
				required
				maxlength="40"
				placeholder="昵称 *"
				class="h-11 rounded-xl border border-zinc-200 bg-zinc-50 px-3.5 text-sm text-zinc-900 outline-none transition-colors placeholder:text-zinc-400 focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-brand-500"
			/>
			<input
				id="comment-email"
				type="email"
				placeholder="邮箱（可选，不公开）"
				class="h-11 rounded-xl border border-zinc-200 bg-zinc-50 px-3.5 text-sm text-zinc-900 outline-none transition-colors placeholder:text-zinc-400 focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-brand-500"
			/>
		</div>
		<textarea
			id="comment-content"
			required
			maxlength="2000"
			rows="4"
			placeholder="写下你的想法…（支持 Markdown 粗体、链接、代码）"
			class="mt-3 w-full resize-y rounded-xl border border-zinc-200 bg-zinc-50 px-3.5 py-3 text-sm leading-relaxed text-zinc-900 outline-none transition-colors placeholder:text-zinc-400 focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-brand-500"
		></textarea>
		<div class="mt-3 flex items-center justify-between">
			<span class="text-xs text-zinc-400 dark:text-zinc-600">
				<span id="char-count">0</span>/2000 · 评论由 IP 哈希防刷，请友善发言
			</span>
			<button
				type="submit"
				id="comment-submit"
				class="inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-brand-600 to-sky-500 px-5 py-2 text-xs font-semibold text-white shadow-md shadow-brand-500/25 transition-all hover:-translate-y-0.5 hover:shadow-lg disabled:translate-y-0 disabled:opacity-60"
			>
				发表评论
			</button>
		</div>
		<p
			id="comment-msg"
			class="mt-2 hidden text-xs font-medium"
			aria-live="polite"
		>
		</p>
	</form>

	<!-- 评论列表 -->
	<div id="comment-list" class="mt-8 space-y-6">
		<p id="comment-loading" class="py-8 text-center text-sm text-zinc-400 dark:text-zinc-600">
			加载评论中…
		</p>
		<p id="comment-empty" class="hidden rounded-2xl border border-dashed border-zinc-300 py-10 text-center text-sm text-zinc-400 dark:border-zinc-700 dark:text-zinc-500">
			还没有评论，来做第一个留言的人吧
		</p>
	</div>
</section>

<script>
	interface CommentItem {
		id: number;
		parentId: number | null;
		authorName: string;
		authorUrl: string | null;
		content: string;
		createdAt: string;
	}

	const esc = (s: string) =>
		s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');

	/** 极简安全渲染：粗体/斜体/行内代码/链接/换行 */
	function renderContent(md: string): string {
		let html = esc(md);
		html = html.replace(/`([^`\n]+)`/g, '<code class="rounded bg-zinc-100 px-1 py-0.5 font-mono text-[0.85em] dark:bg-zinc-800">$1</code>');
		html = html.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
		html = html.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');
		html = html.replace(
			/https?:\/\/[^\s<>"')]+/g,
			(m) => `<a href="${m}" target="_blank" rel="noopener noreferrer nofollow" class="text-brand-600 hover:underline dark:text-amber-400">${m.length > 60 ? m.slice(0, 57) + '…' : m}</a>`,
		);
		return html;
	}

	function avatar(name: string): string {
		const colors = [
			'from-indigo-500 to-violet-500',
			'from-sky-500 to-cyan-400',
			'from-emerald-500 to-teal-400',
			'from-amber-500 to-orange-500',
			'from-rose-500 to-pink-500',
			'from-fuchsia-500 to-purple-600',
		];
		let sum = 0;
		for (const c of name) sum += c.charCodeAt(0);
		return colors[sum % colors.length]!;
	}

	function fmtDate(iso: string): string {
		const d = new Date(iso);
		const diff = Date.now() - d.getTime();
		const min = Math.floor(diff / 60_000);
		if (min < 1) return '刚刚';
		if (min < 60) return `${min} 分钟前`;
		const hour = Math.floor(min / 60);
		if (hour < 24) return `${hour} 小时前`;
		const day = Math.floor(hour / 24);
		if (day < 30) return `${day} 天前`;
		return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
	}

	function commentNode(item: CommentItem, depth: number): HTMLElement {
		const el = document.createElement('article');
		el.className = depth > 0 ? 'flex gap-3 sm:ml-12' : 'flex gap-3';
		const inner = depth > 0 ? '' : 'sm:pb-1';
		const nameHtml = item.authorUrl
			? `<a href="${esc(item.authorUrl)}" target="_blank" rel="noopener noreferrer nofollow" class="font-semibold text-zinc-900 hover:text-brand-600 dark:text-zinc-100 dark:hover:text-amber-300">${esc(item.authorName)}</a>`
			: `<span class="font-semibold text-zinc-900 dark:text-zinc-100">${esc(item.authorName)}</span>`;
		el.innerHTML = `
			<span class="flex h-9 w-9 shrink-0 select-none items-center justify-center rounded-full bg-gradient-to-br ${avatar(item.authorName)} text-xs font-bold text-white" aria-hidden="true">
				${esc(item.authorName.charAt(0).toUpperCase())}
			</span>
			<div class="min-w-0 flex-1 ${inner}">
				<div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5">
					${nameHtml}
					<time class="text-xs text-zinc-400 dark:text-zinc-600">${fmtDate(item.createdAt)}</time>
				</div>
				<div class="comment-body mt-1.5 text-sm leading-relaxed break-words text-zinc-600 dark:text-zinc-300"></div>
				<button type="button" class="reply-btn mt-1.5 text-xs font-medium text-zinc-400 transition-colors hover:text-brand-600 dark:text-zinc-500 dark:hover:text-amber-300" data-id="${item.id}" data-name="${esc(item.authorName)}">
					回复
				</button>
			</div>
		`;
		(el.querySelector('.comment-body') as HTMLElement).innerHTML = renderContent(item.content);
		return el;
	}

	function renderList(items: CommentItem[]) {
		const list = document.getElementById('comment-list');
		const empty = document.getElementById('comment-empty');
		const loading = document.getElementById('comment-loading');
		const total = document.getElementById('comment-total');
		if (!list || !empty || !loading || !total) return;

		loading.classList.add('hidden');
		total.textContent = items.length > 0 ? `· ${items.length}` : '';

		list.querySelectorAll('article, .comment-thread').forEach((n) => n.remove());
		if (!items.length) {
			empty.classList.remove('hidden');
			return;
		}
		empty.classList.add('hidden');

		const byParent = new Map<number | null, CommentItem[]>();
		for (const item of items) {
			const key = item.parentId && items.some((i) => i.id === item.parentId) ? item.parentId : null;
			if (!byParent.has(key)) byParent.set(key, []);
			byParent.get(key)!.push(item);
		}

		const roots = byParent.get(null) ?? [];
		const topLevel = document.createElement('div');
		topLevel.className = 'space-y-6';
		for (const root of roots) {
			const thread = document.createElement('div');
			thread.className = 'comment-thread space-y-5 border-b border-zinc-100 pb-6 last:border-0 dark:border-zinc-800/60';
			thread.appendChild(commentNode(root, 0));
			const children = byParent.get(root.id) ?? [];
			const childWrap = document.createElement('div');
			childWrap.className = 'space-y-5';
			for (const child of children) childWrap.appendChild(commentNode(child, 1));
			if (children.length) thread.appendChild(childWrap);
			topLevel.appendChild(thread);
		}
		list.appendChild(topLevel);
	}

	function setReply(id: number | null, name?: string) {
		const input = document.getElementById('reply-to') as HTMLInputElement | null;
		const banner = document.getElementById('reply-banner');
		const text = document.getElementById('reply-banner-text');
		if (!input || !banner || !text) return;
		if (id && name) {
			input.value = String(id);
			text.textContent = `回复 @${name}`;
			banner.classList.remove('hidden');
		} else {
			input.value = '';
			banner.classList.add('hidden');
		}
	}

	function showMsg(msg: string, ok: boolean) {
		const el = document.getElementById('comment-msg');
		if (!el) return;
		el.textContent = msg;
		el.className = `mt-2 text-xs font-medium ${ok ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400'}`;
	}

	const initComments = () => {
		const root = document.getElementById('comments');
		if (!root) return;
		const slug = root.dataset.slug;
		if (!slug) return;

		// 加载评论
		void (async () => {
			try {
				const res = await fetch(`/api/posts/${slug}/comments`);
				if (!res.ok) throw new Error();
				const data = (await res.json()) as { items: CommentItem[] };
				renderList(data.items);
			} catch {
				const loading = document.getElementById('comment-loading');
				loading?.classList.add('hidden');
				const list = document.getElementById('comment-list');
				const p = document.createElement('p');
				p.className = 'py-8 text-center text-sm text-zinc-400';
				p.textContent = '评论加载失败，刷新页面试试';
				list?.appendChild(p);
			}
		})();

		// 回复按钮（事件委托）
		document.getElementById('comment-list')?.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (!target.classList.contains('reply-btn')) return;
			const id = Number(target.dataset.id);
			setReply(id, target.dataset.name);
			document.getElementById('comment-form')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
		});
		document.getElementById('reply-cancel')?.addEventListener('click', () => setReply(null));

		// 字数统计
		const content = document.getElementById('comment-content') as HTMLTextAreaElement | null;
		const charCount = document.getElementById('char-count');
		content?.addEventListener('input', () => {
			if (charCount) charCount.textContent = String(content.value.length);
		});

		// 提交
		const form = document.getElementById('comment-form') as HTMLFormElement | null;
		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const name = (document.getElementById('comment-name') as HTMLInputElement).value.trim();
			const email = (document.getElementById('comment-email') as HTMLInputElement).value.trim();
			const body = (document.getElementById('comment-content') as HTMLTextAreaElement).value.trim();
			const parentId = Number((document.getElementById('reply-to') as HTMLInputElement).value) || null;
			if (!name || !body) {
				showMsg('请填写昵称和评论内容', false);
				return;
			}
			const btn = document.getElementById('comment-submit') as HTMLButtonElement;
			btn.disabled = true;
			try {
				const res = await fetch(`/api/posts/${slug}/comments`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ authorName: name, authorEmail: email || undefined, content: body, parentId }),
				});
				const data = await res.json();
				if (!res.ok) {
					showMsg(String(data.error ?? '提交失败，请稍后再试'), false);
					return;
				}
				const pending = (data as { pending?: boolean }).pending;
				showMsg(pending ? '评论已提交，审核通过后显示' : '评论成功！', true);
				form.reset();
				if (charCount) charCount.textContent = '0';
				setReply(null);
				renderList((data as { items: CommentItem[] }).items ?? []);
				setTimeout(() => document.getElementById('comment-msg')?.classList.add('hidden'), 3000);
			} catch {
				showMsg('网络错误，请稍后再试', false);
			} finally {
				btn.disabled = false;
			}
		});
	};
	document.addEventListener('astro:page-load', initComments);
</script>
