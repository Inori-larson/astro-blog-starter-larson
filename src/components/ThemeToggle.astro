---
// 世界观切换按钮：碧蓝航线（浅色）⇄ Fate（暗色）
// 图标语义：太阳=白天的母港，月亮=圣杯战争之夜
interface Props {
	/** 显示文字标签 */
	showLabel?: boolean;
	/** 标签布局：row = 侧边栏整行；pill = 前台顶栏胶囊（图标+文字，移动端隐藏文字） */
	labelAlign?: 'row' | 'pill' | 'col';
}

const { showLabel = false, labelAlign = 'col' } = Astro.props;
---

<button
	id="theme-toggle"
	type="button"
	aria-label="切换世界观：碧蓝航线 / Fate"
	class:list={[
		'group transition-all text-zinc-500 dark:text-amber-200/70',
		labelAlign === 'row' && showLabel
			? 'flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium hover:bg-zinc-100 dark:hover:bg-zinc-800'
			: labelAlign === 'pill' && showLabel
				? 'inline-flex h-9 items-center gap-1.5 rounded-full border border-zinc-200/80 bg-white/60 px-3 text-xs font-medium backdrop-blur transition-colors hover:border-zinc-300 hover:text-zinc-700 dark:border-zinc-700 dark:bg-zinc-900/60 dark:hover:border-zinc-600 dark:hover:text-zinc-300'
				: 'inline-flex h-9 w-9 items-center justify-center rounded-full hover:bg-sky-100 hover:text-brand-600 dark:hover:bg-amber-500/10 dark:hover:text-amber-400',
	]}
>
	<!-- 白天：碧蓝航线——舵轮/太阳（浅色模式显示） -->
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		class="h-[1.15rem] w-[1.15rem] shrink-0 transition-transform duration-500 group-hover:rotate-90 dark:hidden text-brand-600"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path
			d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
		></path>
	</svg>
	<!-- 夜晚：Fate——月之魔术（暗色模式显示，金色） -->
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		class="hidden h-[1.15rem] w-[1.15rem] shrink-0 transition-transform duration-500 group-hover:-rotate-12 dark:block text-amber-400"
		aria-hidden="true"
	>
		<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
		<path d="M19 3v4M21 5h-4" stroke-width="1.5"></path>
	</svg>

	{
		showLabel && (
			<span class:list={['theme-toggle-label select-none', labelAlign === 'pill' && 'hidden sm:inline']}>
				<span class="dark:hidden">港区 · 白昼</span>
				<span class="hidden dark:inline">圣杯 · 深夜</span>
			</span>
		)
	}
</button>

<script>
	// 兼容两种环境：前台（View Transitions 软导航）与后台/登录页（无 ClientRouter 的整页加载）
	// 注意：SSR 流式渲染下 head 中的 module 脚本可能早于 body 渲染执行，
	// 此时按钮尚未存在——需等待 DOM 就绪后再绑定
	const bindThemeToggle = () => {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return false;
		// 幂等：同一按钮只绑一次
		if (btn.dataset.toggleBound) return true;
		btn.dataset.toggleBound = '1';
		btn.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		});
		return true;
	};

	const tryBind = () => {
		if (bindThemeToggle()) return;
		// 按钮未就绪：等 DOM 完成后重试
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', () => bindThemeToggle(), { once: true });
		} else {
			// 极端情况：流式渲染仍在进行，用轮询兜底（500ms 内）
			let tries = 0;
			const timer = setInterval(() => {
				if (bindThemeToggle() || ++tries > 20) clearInterval(timer);
			}, 25);
		}
	};

	// 防重复初始化：同一文档只挂一次监听（软导航时 astro:page-load 负责重绑新按钮）
	if (!document.documentElement.dataset.themeToggleReady) {
		document.documentElement.dataset.themeToggleReady = '1';
		tryBind();
		document.addEventListener('astro:page-load', tryBind);
	}
</script>
