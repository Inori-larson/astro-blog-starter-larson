---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb } from '../lib/db';
import { cached } from '../lib/cache';
import { listPosts } from '../lib/posts';
import { SITE_TITLE } from '../consts';

const db = getDb(Astro);
const posts = await cached(Astro, 'posts:list', 300, () => listPosts(db));

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
	const year = new Date(p.publishedAt).getFullYear();
	if (!byYear.has(year)) byYear.set(year, []);
	byYear.get(year)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const currentYear = new Date().getFullYear();

const fmt = (d: Date | string) =>
	`${String(new Date(d).getMonth() + 1).padStart(2, '0')}.${String(new Date(d).getDate()).padStart(2, '0')}`;
---

<BaseLayout title={`归档 · ${SITE_TITLE}`} description="全部文章按时间归档">
	<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
		<header class="reveal is-visible">
			<h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
				归档
			</h1>
			<p class="mt-3 text-zinc-500 dark:text-zinc-400">
				共 {posts.length} 篇文章，跨越 {years.length} 个年份
			</p>
		</header>

		<div class="mt-10 space-y-12">
			{
				years.map((year) => (
					<section class="reveal">
						<div class="flex items-baseline gap-3">
							<h2 class="text-2xl font-bold text-zinc-900 dark:text-white">{year}</h2>
							{
								year === currentYear && (
									<span class="rounded-full bg-gradient-to-r from-brand-500 to-violet-500 px-2 py-0.5 text-[10px] font-bold text-white">
										今年
									</span>
								)
							}
							<span class="text-sm text-zinc-400 dark:text-zinc-500">
								{byYear.get(year)!.length} 篇
							</span>
							<div class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800" aria-hidden="true" />
						</div>
						<ul class="mt-4 space-y-1">
							{byYear.get(year)!.map((p) => (
								<li>
									<a
										href={`/blog/${p.slug}/`}
										class="group flex items-center gap-4 rounded-xl px-3 py-2.5 transition-colors hover:bg-white dark:hover:bg-zinc-900"
									>
										<time class="w-14 shrink-0 font-mono text-xs text-zinc-400 transition-colors group-hover:text-brand-500 dark:text-zinc-500 dark:group-hover:text-brand-400">
											{fmt(p.publishedAt)}
										</time>
										<span class="flex-1 truncate font-medium text-zinc-700 transition-colors group-hover:text-brand-600 dark:text-zinc-300 dark:group-hover:text-brand-400">
											{p.title}
										</span>
										<span class="hidden shrink-0 text-xs text-zinc-400 sm:block dark:text-zinc-600">
											{p.readingMinutes} 分钟
										</span>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											class="h-4 w-4 shrink-0 text-zinc-300 opacity-0 transition-opacity group-hover:opacity-100 dark:text-zinc-600"
											aria-hidden="true"
										>
											<path d="m9 18 6-6-6-6" />
										</svg>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</section>
</BaseLayout>
