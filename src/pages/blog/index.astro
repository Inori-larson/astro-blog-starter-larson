---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import { readingTimeMinutes } from '../../lib/utils';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))];
---

<BaseLayout title={`博客 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
		<header class="reveal is-visible">
			<h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
				博客
			</h1>
			<p class="mt-3 text-zinc-500 dark:text-zinc-400">
				共 {posts.length} 篇文章，记录技术与生活的所思所想
			</p>
		</header>

		<!-- 标签筛选 -->
		{
			allTags.length > 0 && (
				<div class="reveal is-visible mt-8 flex flex-wrap gap-2" role="group" aria-label="按标签筛选">
					<button
						type="button"
						data-filter-tag=""
						class="filter-chip rounded-full border px-4 py-1.5 text-sm font-medium transition-all"
						aria-pressed="true"
					>
						全部
					</button>
					{allTags.map((tag) => (
						<button
							type="button"
							data-filter-tag={tag}
							class="filter-chip rounded-full border px-4 py-1.5 text-sm font-medium transition-all"
							aria-pressed="false"
						>
							{tag}
						</button>
					))}
				</div>
			)
		}

		<!-- 文章网格 -->
		<div id="post-grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				posts.map((post, i) => (
					<div class="reveal" data-tags={post.data.tags.join(',')} style={`transition-delay:${Math.min(i, 5) * 60}ms`}>
						<PostCard
							title={post.data.title}
							description={post.data.description}
							pubDate={post.data.pubDate}
							heroImage={post.data.heroImage}
							tags={post.data.tags}
							href={`/blog/${post.id}/`}
							readingTime={readingTimeMinutes(post.body ?? '')}
						/>
					</div>
				))
			}
		</div>

		<!-- 筛选无结果 -->
		<p
			id="empty-state"
			class="hidden rounded-2xl border border-dashed border-zinc-300 py-16 text-center text-sm text-zinc-400 dark:border-zinc-700 dark:text-zinc-500"
		>
			该标签下暂时没有文章
		</p>
	</section>
</BaseLayout>

<style>
	.filter-chip {
		border-color: var(--color-zinc-200);
		background-color: color-mix(in srgb, white 60%, transparent);
		color: var(--color-zinc-500);
	}
	.filter-chip:hover {
		border-color: var(--color-brand-400);
		color: var(--color-brand-600);
	}
	.filter-chip[aria-pressed='true'] {
		border-color: transparent;
		background-image: linear-gradient(to right, var(--color-brand-600), var(--color-violet-600));
		color: white;
		box-shadow: 0 4px 12px color-mix(in srgb, var(--color-brand-500) 30%, transparent);
	}
	:global(.dark) .filter-chip {
		border-color: var(--color-zinc-700);
		background-color: color-mix(in srgb, var(--color-zinc-900) 60%, transparent);
		color: var(--color-zinc-400);
	}
	:global(.dark) .filter-chip:hover {
		border-color: var(--color-brand-500);
		color: var(--color-brand-400);
	}
	:global(.dark) .filter-chip[aria-pressed='true'] {
		color: white;
	}
</style>

<script>
	const initFilter = () => {
		const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]');
		const cards = document.querySelectorAll<HTMLElement>('[data-tags]');
		const emptyState = document.getElementById('empty-state');
		if (!chips.length || !cards.length) return;

		const applyFilter = (tag: string) => {
			let visible = 0;
			cards.forEach((card) => {
				const tags = (card.getAttribute('data-tags') ?? '')
					.split(',')
					.filter(Boolean);
				const show = !tag || tags.includes(tag);
				card.classList.toggle('hidden', !show);
				if (show) visible++;
			});
			emptyState?.classList.toggle('hidden', visible > 0);

			chips.forEach((chip) => {
				chip.setAttribute(
					'aria-pressed',
					String(chip.getAttribute('data-filter-tag') === tag),
				);
			});

			const url = tag ? `?tag=${encodeURIComponent(tag)}` : '/blog';
			history.replaceState(null, '', url);
		};

		chips.forEach((chip) => {
			chip.addEventListener('click', () =>
				applyFilter(chip.getAttribute('data-filter-tag') ?? ''),
			);
		});

		// 初始状态：读取 URL 中的 ?tag=
		const initial = new URLSearchParams(location.search).get('tag') ?? '';
		if (initial && [...chips].some((c) => c.getAttribute('data-filter-tag') === initial)) {
			applyFilter(initial);
		}
	};
	document.addEventListener('astro:page-load', initFilter);
</script>
