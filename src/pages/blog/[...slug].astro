---
import BlogPost from '../../layouts/BlogPost.astro';
import { getDb } from '../../lib/db';
import { cached } from '../../lib/cache';
import { getPostBySlug, getNeighbors, getRelated } from '../../lib/posts';
import { getLikeState, getTotalViews } from '../../lib/interactions';
import { visitorHash } from '../../lib/visitor';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/blog/');
// slug 格式校验：不合法直接 404，不产生缓存键与数据库查询
if (!/^[a-z0-9-]+$/.test(slug)) return Astro.rewrite('/404');

const db = getDb(Astro);
const post = await cached(Astro, `post:${slug}`, 300, () => getPostBySlug(db, slug));
if (!post) return Astro.rewrite('/404');

const [neighborInfo, related, likeState, viewCount] = await Promise.all([
	getNeighbors(db, post.publishedAt),
	getRelated(db, post.id, post.tags),
	getLikeState(db, post.id, await visitorHash(Astro.request)),
	getTotalViews(db, post.id),
]);
const { prev, next } = neighborInfo;

const headings = post.contentHtml
	? [...post.contentHtml.matchAll(/<h([2-3]) id="([^"]*)"[^>]*>([\s\S]*?)<\/h\1>/g)].map((m) => ({
			depth: Number(m[1]),
			slug: m[2],
			text: m[3].replace(/<[^>]+>/g, '').trim(),
		}))
	: [];
---

<BlogPost
	title={post.title}
	description={post.description}
	pubDate={post.publishedAt}
	updatedDate={post.updatedAt ?? undefined}
	heroImage={post.heroImage ?? undefined}
	tags={post.tags}
	headings={headings}
	readingTime={post.readingMinutes}
	slug={post.slug}
	likeCount={likeState.count}
	liked={likeState.liked}
	viewCount={viewCount}
	{prev}
	{next}
	{related}
>
	<Fragment set:html={post.contentHtml} />
</BlogPost>
