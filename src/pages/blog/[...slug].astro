---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { readingTimeMinutes } from '../../lib/utils';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const sorted = posts.sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return sorted.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			prev: sorted[i + 1]
				? { title: sorted[i + 1].data.title, href: `/blog/${sorted[i + 1].id}/` }
				: undefined,
			next: sorted[i - 1]
				? { title: sorted[i - 1].data.title, href: `/blog/${sorted[i - 1].id}/` }
				: undefined,
		},
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	prev?: { title: string; href: string };
	next?: { title: string; href: string };
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingTimeMinutes(post.body ?? '');

// 相关文章：按共享标签数排序，同分则取更新的
const allPosts = await getCollection('blog');
const related = allPosts
	.filter((p) => p.id !== post.id)
	.map((p) => ({
		post: p,
		score: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
	}))
	.sort(
		(a, b) =>
			b.score - a.score ||
			b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf(),
	)
	.slice(0, 3)
	.map(({ post: p }) => ({
		title: p.data.title,
		href: `/blog/${p.id}/`,
		readingTime: readingTimeMinutes(p.body ?? ''),
	}));
---

<BlogPost
	title={post.data.title}
	description={post.data.description}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	heroImage={post.data.heroImage}
	tags={post.data.tags}
	headings={headings}
	readingTime={minutes}
	{prev}
	{next}
	{related}
>
	<Content />
</BlogPost>
