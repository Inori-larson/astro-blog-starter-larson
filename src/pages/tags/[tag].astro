---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getDb } from '../../lib/db';
import { cached } from '../../lib/cache';
import { listPostsByTag } from '../../lib/posts';

export const prerender = false;

const { tag } = Astro.params;
if (!tag) return Astro.redirect('/tags/');

const tagName = decodeURIComponent(tag);
const db = getDb(Astro);
const posts = await cached(Astro, `tags:posts:${tagName}`, 300, () =>
	listPostsByTag(db, tagName),
);
---

<BaseLayout title={`#${tagName}`} description={`标签「${tagName}」下的全部文章`}>
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
		<header class="reveal is-visible">
			<p class="flex items-center gap-1.5 text-sm font-medium text-zinc-400 dark:text-zinc-500">
				<a href="/tags" class="transition-colors hover:text-brand-600 dark:hover:text-amber-300">
					标签
				</a>
				<span aria-hidden="true">/</span>
			</p>
			<h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
				#{tagName}
			</h1>
			<p class="mt-3 text-zinc-500 dark:text-zinc-400">共 {posts.length} 篇文章</p>
		</header>

		{
			posts.length > 0 ? (
				<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{posts.map((p, i) => (
						<div class="reveal" style={`transition-delay:${Math.min(i, 5) * 60}ms`}>
							<PostCard
								title={p.title}
								description={p.description}
								pubDate={p.publishedAt}
								heroImage={p.heroImage ?? undefined}
								tags={p.tags}
								href={`/blog/${p.slug}/`}
								readingTime={p.readingMinutes}
								slug={p.slug}
							/>
						</div>
					))}
				</div>
			) : (
				<p class="mt-10 rounded-2xl border border-dashed border-zinc-300 py-16 text-center text-sm text-zinc-400 dark:border-zinc-700 dark:text-zinc-500">
					该标签下暂时没有文章
				</p>
			)
		}
	</section>
</BaseLayout>
