---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { readingTimeMinutes } from '../../lib/utils';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
	return tags.map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: posts
				.filter((p) => p.data.tags.includes(tag))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

interface Props {
	tag: string;
	posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag} · ${SITE_TITLE}`} description={`标签「${tag}」下的全部文章`}>
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
		<header class="reveal is-visible">
			<p class="flex items-center gap-1.5 text-sm font-medium text-zinc-400 dark:text-zinc-500">
				<a href="/tags" class="transition-colors hover:text-brand-600 dark:hover:text-brand-400">
					标签
				</a>
				<span aria-hidden="true">/</span>
			</p>
			<h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
				#{tag}
			</h1>
			<p class="mt-3 text-zinc-500 dark:text-zinc-400">共 {posts.length} 篇文章</p>
		</header>

		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				posts.map((p, i) => (
					<div class="reveal" style={`transition-delay:${Math.min(i, 5) * 60}ms`}>
						<PostCard
							title={p.data.title}
							description={p.data.description}
							pubDate={p.data.pubDate}
							heroImage={p.data.heroImage}
							tags={p.data.tags}
							href={`/blog/${p.id}/`}
							readingTime={readingTimeMinutes(p.body ?? '')}
							slug={p.id}
						/>
					</div>
				))
			}
		</div>
	</section>
</BaseLayout>
