---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const tagCounts = new Map<string, number>();
for (const p of posts) {
	for (const t of p.data.tags) {
		tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
	}
}
const sorted = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title={`标签 · ${SITE_TITLE}`} description="按标签浏览全站文章">
	<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
		<header class="reveal is-visible">
			<h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
				标签
			</h1>
			<p class="mt-3 text-zinc-500 dark:text-zinc-400">
				共 {sorted.length} 个标签，{posts.length} 篇文章
			</p>
		</header>

		<div class="reveal mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{
				sorted.map(([tag, count]) => (
					<a
						href={`/tags/${encodeURIComponent(tag)}`}
						class="group flex items-center justify-between rounded-2xl border border-zinc-200/80 bg-white px-5 py-4 transition-all hover:-translate-y-0.5 hover:border-brand-300/60 hover:shadow-lg hover:shadow-brand-500/10 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-brand-500/40"
					>
						<span class="font-semibold text-zinc-800 transition-colors group-hover:text-brand-600 dark:text-zinc-200 dark:group-hover:text-brand-400">
							#{tag}
						</span>
						<span class="ml-3 shrink-0 rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs text-zinc-400 dark:bg-zinc-800 dark:text-zinc-500">
							{count} 篇
						</span>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
