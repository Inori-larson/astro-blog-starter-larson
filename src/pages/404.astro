---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';

export const prerender = true;
---

<BaseLayout title={`页面不存在 · ${SITE_TITLE}`} description="404 - 页面不存在">
	<section class="relative mx-auto flex max-w-6xl flex-col items-center px-4 py-24 text-center sm:px-6 sm:py-32">
		<div
			class="pointer-events-none absolute top-1/2 left-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-500/10 blur-3xl"
			aria-hidden="true"
		>
		</div>

		<p class="text-gradient font-mono text-8xl font-bold sm:text-9xl">404</p>
		<h1 class="mt-6 text-2xl font-bold text-zinc-900 dark:text-zinc-100">
			<span class="dark:hidden">这片海域尚未开辟</span>
			<span class="hidden dark:inline">此路通往梦境的彼端</span>
		</h1>
		<p class="mt-3 max-w-sm text-sm text-zinc-500 dark:text-zinc-400">
			<span class="dark:hidden">航线偏离了航图——你要找的页面不存在，或已被移往新的泊位。</span>
			<span class="hidden dark:inline">魔术回路未能抵达目的地——页面不存在，或已被转移至圣杯的深处。</span>
		</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a
				href="/"
				class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-600 to-sky-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/30 transition-all hover:-translate-y-0.5 hover:shadow-xl"
			>
				<span class="dark:hidden">返回母港</span>
				<span class="hidden dark:inline">返回现实</span>
			</a>
			<a
				href="/blog"
				class="inline-flex items-center gap-2 rounded-full border border-zinc-300 px-6 py-3 text-sm font-semibold text-zinc-700 transition-all hover:-translate-y-0.5 hover:border-zinc-400 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500"
			>
				浏览博客
			</a>
		</div>
	</section>
</BaseLayout>
