---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR_NAME } from '../consts';
import { projects } from '../data/projects';
import { getDb } from '../lib/db';
import { cached } from '../lib/cache';
import { listPosts, listTagCounts } from '../lib/posts';

const db = getDb(Astro);
const posts = await cached(Astro, 'posts:list', 300, () => listPosts(db));
const tagCountsList = await cached(Astro, 'tags:counts', 300, () => listTagCounts(db));
const allTags = tagCountsList.map((t) => t.name);
const tagCounts = new Map(tagCountsList.map((t) => [t.name, t.count]));
const [featured, ...rest] = posts;
const featuredProjects = projects.filter((p) => p.featured);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<!-- 装饰光斑 -->
		<div
			class="pointer-events-none absolute -top-24 left-1/2 h-96 w-[42rem] -translate-x-1/2 rounded-full bg-gradient-to-r from-brand-500/20 via-sky-400/15 to-cyan-300/20 blur-3xl"
			aria-hidden="true"
		>
		</div>
		<div
			class="pointer-events-none absolute top-32 -right-20 h-64 w-64 rounded-full bg-sky-300/10 blur-3xl"
			aria-hidden="true"
		>
		</div>
		<!-- 碧蓝航线（浅色）：海平面装饰纹 -->
		<div
			class="pointer-events-none absolute inset-x-0 bottom-0 h-24 opacity-40 dark:opacity-0"
			style="background: repeating-radial-gradient(circle at 50% 120%, transparent 0 18px, rgba(59,130,246,0.12) 18px 19px);"
			aria-hidden="true"
		>
		</div>
		<!-- Fate（暗色）：魔术回路星点 -->
		<div
			class="pointer-events-none absolute inset-x-0 top-0 h-64 hidden opacity-[0.14] dark:block"
			style="background-image: radial-gradient(circle at 25% 0%, #d4af37 0 1px, transparent 1px), radial-gradient(circle at 75% 30%, #a61e2b 0 1px, transparent 1px); background-size: 64px 64px;"
			aria-hidden="true"
		>
		</div>

		<div class="relative mx-auto max-w-6xl px-4 pt-20 pb-16 text-center sm:px-6 sm:pt-28 sm:pb-20">
			<p
				class="reveal is-visible inline-flex items-center gap-2 rounded-full border border-sky-200/80 bg-white/70 px-4 py-1.5 text-sm backdrop-blur dark:border-amber-500/30 dark:bg-zinc-900/70"
			>
				<span class="relative flex h-2 w-2">
					<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-sky-400 opacity-75 dark:bg-amber-400"></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-brand-500 dark:bg-fate-gold"></span>
				</span>
				<span class="font-medium text-brand-700 dark:text-amber-300">母港通讯 · 持续更新中</span>
			</p>

			<h1
				class="reveal is-visible mx-auto mt-6 max-w-3xl text-4xl leading-tight font-bold tracking-tight text-zinc-900 sm:text-5xl md:text-6xl dark:text-zinc-100"
			>
				你好，我是
				<span class="text-gradient">{AUTHOR_NAME}</span>
				<br class="hidden sm:block" />
				<span class="dark:hidden">欢迎回到这片数字母港</span>
				<span class="hidden dark:inline">圣杯问答，今夜开始</span>
			</h1>

			<p
				class="reveal is-visible mx-auto mt-6 max-w-xl text-base leading-relaxed text-zinc-500 sm:text-lg dark:text-zinc-400"
			>
				一名爱写代码也爱写文字的开发者。在这里记录技术笔记、项目复盘与生活随想，把踩过的坑写成文字，分享给同样在路上的人。
			</p>

			<div class="reveal is-visible mt-9 flex flex-wrap items-center justify-center gap-3">
				<a
					href="/blog"
					class="group inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-600 to-sky-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/30 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand-500/40"
				>
					浏览博客
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
						aria-hidden="true"
					>
						<path d="M5 12h14m-6-6 6 6-6 6"></path>
					</svg>
				</a>
				<a
					href="/projects"
					class="inline-flex items-center gap-2 rounded-full border border-zinc-300 bg-white/60 px-6 py-3 text-sm font-semibold text-zinc-700 backdrop-blur transition-all hover:-translate-y-0.5 hover:border-zinc-400 dark:border-zinc-700 dark:bg-zinc-900/60 dark:text-zinc-300 dark:hover:border-zinc-500"
				>
					看看项目
				</a>
			</div>

			<!-- 统计 -->
			<div class="reveal is-visible mx-auto mt-14 grid max-w-xl grid-cols-2 gap-4 sm:grid-cols-4">
				<div
					class="rounded-2xl border border-zinc-200/70 bg-white/60 p-4 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-900/60"
				>
					<p class="text-2xl font-bold text-zinc-900 dark:text-white">{posts.length}</p>
					<p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-500">篇文章</p>
				</div>
				<div
					class="rounded-2xl border border-zinc-200/70 bg-white/60 p-4 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-900/60"
				>
					<p class="text-2xl font-bold text-zinc-900 dark:text-white">{allTags.length}</p>
					<p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-500">个标签</p>
				</div>
				<div
					class="rounded-2xl border border-zinc-200/70 bg-white/60 p-4 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-900/60"
				>
					<p class="text-2xl font-bold text-zinc-900 dark:text-white">{projects.length}</p>
					<p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-500">个项目</p>
				</div>
				<div
					class="rounded-2xl border border-zinc-200/70 bg-white/60 p-4 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-900/60"
				>
					<p class="text-2xl font-bold text-zinc-900 dark:text-white">∞</p>
					<p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-500">好奇心</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 精选文章 -->
	{
		featured && (
			<section class="mx-auto max-w-6xl px-4 sm:px-6">
				<div class="reveal flex items-center justify-between">
					<h2 class="text-xl font-bold text-zinc-900 sm:text-2xl dark:text-white">最新发布</h2>
					<a
						href="/blog"
						class="group inline-flex items-center gap-1 text-sm font-medium text-zinc-500 transition-colors hover:text-brand-600 dark:text-zinc-400 dark:hover:text-amber-300"
					>
						全部文章
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
							<path d="M5 12h14m-6-6 6 6-6 6" />
						</svg>
					</a>
				</div>
				<div class="reveal mt-5">
					<PostCard
						title={featured.title}
						description={featured.description}
						pubDate={featured.publishedAt}
						heroImage={featured.heroImage ?? undefined}
						tags={featured.tags}
						href={`/blog/${featured.slug}/`}
						readingTime={featured.readingMinutes}
						slug={featured.slug}
						featured
					/>
				</div>
			</section>
		)
	}

	<!-- 文章网格 -->
	{
		rest.length > 0 && (
			<section class="mx-auto mt-14 max-w-6xl px-4 sm:px-6">
				<h2 class="reveal text-xl font-bold text-zinc-900 sm:text-2xl dark:text-white">更多文章</h2>
				<div class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{					rest.map((post, i) => (
						<div class="reveal" style={`transition-delay:${Math.min(i, 5) * 60}ms`}>
							<PostCard
								title={post.title}
								description={post.description}
								pubDate={post.publishedAt}
								heroImage={post.heroImage ?? undefined}
								tags={post.tags}
								href={`/blog/${post.slug}/`}
								readingTime={post.readingMinutes}
								slug={post.slug}
							/>
						</div>
					))}
				</div>
			</section>
		)
	}

	<!-- 我的项目 -->
	{
		featuredProjects.length > 0 && (
			<section class="mx-auto mt-16 max-w-6xl px-4 sm:px-6">
				<div class="reveal flex items-center justify-between">
					<h2 class="text-xl font-bold text-zinc-900 sm:text-2xl dark:text-white">我的项目</h2>
					<a
						href="/projects"
						class="group inline-flex items-center gap-1 text-sm font-medium text-zinc-500 transition-colors hover:text-brand-600 dark:text-zinc-400 dark:hover:text-amber-300"
					>
						全部项目
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
							<path d="M5 12h14m-6-6 6 6-6 6" />
						</svg>
					</a>
				</div>
				<div class="reveal mt-5 grid gap-4 sm:grid-cols-2">
					{featuredProjects.map((p) => (
						<a
							href={p.url ?? p.repo ?? '/projects'}
							class="group flex gap-4 rounded-2xl border border-zinc-200/80 bg-white p-5 transition-all hover:-translate-y-1 hover:border-brand-300/60 hover:shadow-xl hover:shadow-brand-500/10 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-amber-500/60/40"
						>
							<span
								class:list={[
									'flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-2xl shadow-lg',
									p.gradient,
								]}
								aria-hidden="true"
							>
								{p.icon}
							</span>
							<span class="min-w-0 flex-1">
								<span class="flex flex-wrap items-center gap-2">
									<span class="font-bold text-zinc-900 transition-colors group-hover:text-brand-600 dark:text-white dark:group-hover:text-amber-300">
										{p.name}
									</span>
									<StatusBadge status={p.status} />
								</span>
								<span class="mt-1 line-clamp-2 block text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
									{p.description}
								</span>
								<span class="mt-2 flex flex-wrap gap-1.5">
									{p.tags.map((t) => (
										<span class="rounded bg-zinc-100 px-2 py-0.5 text-[10px] text-zinc-400 dark:bg-zinc-800 dark:text-zinc-500">
											{t}
										</span>
									))}
								</span>
							</span>
						</a>
					))}
				</div>
			</section>
		)
	}

	<!-- 标签云 -->
	{
		allTags.length > 0 && (
			<section class="mx-auto mt-16 max-w-6xl px-4 pb-20 sm:px-6">
				<div class="reveal rounded-3xl border border-zinc-200/70 bg-white/60 p-8 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-900/60">
					<h2 class="text-center text-lg font-bold text-zinc-900 dark:text-white">按标签探索</h2>
					<div class="mt-5 flex flex-wrap justify-center gap-2.5">
						{allTags.map((tag) => (
							<a
								href={`/tags/${encodeURIComponent(tag)}`}
								class="group inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-4 py-1.5 text-sm text-zinc-600 transition-all hover:-translate-y-0.5 hover:border-brand-400 hover:text-brand-600 hover:shadow-md hover:shadow-brand-500/10 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-amber-500/60 dark:hover:text-amber-300"
							>
								#{tag}
								<span class="rounded-full bg-zinc-100 px-1.5 text-[10px] font-semibold text-zinc-400 transition-colors group-hover:bg-brand-50 group-hover:text-brand-500 dark:bg-zinc-800 dark:text-zinc-500 dark:group-hover:bg-brand-500/10 dark:group-hover:text-amber-300">
									{tagCounts.get(tag)}
								</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}
</BaseLayout>
