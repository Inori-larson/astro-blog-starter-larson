---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { projects } from '../data/projects';
import { SITE_TITLE } from '../consts';

export const prerender = true;

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<BaseLayout title={`项目 · ${SITE_TITLE}`} description="我正在做或已经完成的开源项目与产品">
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
		<header class="reveal is-visible">
			<h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
				项目
			</h1>
			<p class="mt-3 max-w-xl text-zinc-500 dark:text-zinc-400">
				一些我正在折腾或已经完成的东西，从命令行工具到完整产品。
			</p>
		</header>

		<!-- 精选项目 -->
		<div class="mt-10 grid gap-6 lg:grid-cols-2">
			{
				featured.map((p, i) => (
					<article
						class="reveal group overflow-hidden rounded-2xl border border-zinc-200/80 bg-white transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-500/10 dark:border-zinc-800 dark:bg-zinc-900"
						style={`transition-delay:${i * 60}ms`}
					>
						<div
							class:list={[
								'flex h-32 items-center justify-center bg-gradient-to-br text-5xl transition-transform duration-500 group-hover:scale-[1.03]',
								p.gradient,
							]}
						>
							<span aria-hidden="true">{p.icon}</span>
						</div>
						<div class="p-6">
							<div class="flex flex-wrap items-center justify-between gap-2">
								<h2 class="text-xl font-bold text-zinc-900 dark:text-white">{p.name}</h2>
								<StatusBadge status={p.status} />
							</div>
							<p class="mt-2 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{p.description}</p>
							<div class="mt-4 flex flex-wrap gap-1.5">
								{p.tags.map((t) => (
									<span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
										{t}
									</span>
								))}
							</div>
							<div class="mt-5 flex gap-2">
								{p.url && (
									<a
										href={p.url}
										class="inline-flex h-9 items-center gap-1.5 rounded-full bg-gradient-to-r from-brand-600 to-violet-600 px-4 text-xs font-semibold text-white shadow-md shadow-brand-500/25 transition-all hover:-translate-y-0.5"
									>
										访问
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
											<path d="M7 17 17 7" />
											<path d="M7 7h10v10" />
										</svg>
									</a>
								)}
								{p.repo && (
									<a
										href={p.repo}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex h-9 items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-4 text-xs font-semibold text-zinc-600 transition-all hover:-translate-y-0.5 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-600"
									>
										<svg viewBox="0 0 16 16" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
											<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
										</svg>
										源码
									</a>
								)}
							</div>
						</div>
					</article>
				))
			}
		</div>

		<!-- 其他项目 -->
		{
			rest.length > 0 && (
				<div class="mt-12">
					<h2 class="reveal text-xl font-bold text-zinc-900 dark:text-white">更多项目</h2>
					<div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{rest.map((p, i) => (
							<article
								class="reveal group rounded-2xl border border-zinc-200/80 bg-white p-5 transition-all hover:-translate-y-1 hover:border-brand-300/60 hover:shadow-xl hover:shadow-brand-500/10 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-brand-500/40"
								style={`transition-delay:${Math.min(i, 5) * 60}ms`}
							>
								<div class="flex items-start justify-between gap-3">
									<span
										class:list={[
											'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-2xl shadow-lg',
											p.gradient,
										]}
										aria-hidden="true"
									>
										{p.icon}
									</span>
									<StatusBadge status={p.status} />
								</div>
								<h3 class="mt-4 font-bold text-zinc-900 transition-colors group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400">
									{p.name}
								</h3>
								<p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
									{p.description}
								</p>
								<div class="mt-3 flex flex-wrap gap-1.5">
									{p.tags.map((t) => (
										<span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
											{t}
										</span>
									))}
								</div>
								<div class="mt-4 flex gap-3 text-xs font-semibold">
									{p.url && (
										<a href={p.url} class="text-brand-600 transition-colors hover:text-brand-500 dark:text-brand-400">
											访问 →
										</a>
									)}
									{p.repo && (
										<a href={p.repo} target="_blank" rel="noopener noreferrer" class="text-zinc-400 transition-colors hover:text-zinc-600 dark:hover:text-zinc-300">
											源码 ↗
										</a>
									)}
								</div>
							</article>
						))}
					</div>
				</div>
			)
		}
	</section>
</BaseLayout>
