---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="评论审核">
	<div class="mx-auto max-w-4xl">
		<h1 class="text-2xl font-bold text-zinc-900 dark:text-white">评论审核</h1>
		<p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
			当前评论策略为直接发布；此处可批量管理历史评论（标记垃圾 / 撤下 / 删除）。
		</p>

		<div class="mt-6 flex gap-2" role="tablist" aria-label="评论状态筛选">
			{
				[
					{ key: 'all', label: '全部' },
					{ key: 'approved', label: '已发布' },
					{ key: 'pending', label: '待审核' },
					{ key: 'spam', label: '垃圾' },
				].map((tab, i) => (
					<button
						type="button"
						data-filter={tab.key}
						class={`rounded-full border px-4 py-1.5 text-sm font-medium transition-all ${
							i === 0
								? 'border-transparent bg-gradient-to-r from-brand-600 to-violet-600 text-white shadow-md shadow-brand-500/25'
								: 'border-zinc-200 bg-white text-zinc-500 hover:border-zinc-300 hover:text-zinc-700 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200'
						}`}
					>
						{tab.label}
					</button>
				))
			}
		</div>

		<div id="comment-list" class="mt-6 space-y-3">
			<p class="py-10 text-center text-sm text-zinc-400 dark:text-zinc-600">加载中…</p>
		</div>
	</div>

	<script>
		interface AdminComment {
			id: number;
			postId: number;
			postTitle: string | null;
			postSlug: string | null;
			parentId: number | null;
			authorName: string;
			content: string;
			status: string;
			createdAt: string;
		}

		const esc = (s: string) =>
			s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');

		const fmtDate = (v: string) =>
			new Date(v).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });

		const STATUS_STYLE: Record<string, string> = {
			approved: 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400',
			pending: 'bg-amber-50 text-amber-600 dark:bg-amber-500/10 dark:text-amber-400',
			spam: 'bg-rose-50 text-rose-600 dark:bg-rose-500/10 dark:text-rose-400',
		};
		const STATUS_LABEL: Record<string, string> = {
			approved: '已发布',
			pending: '待审核',
			spam: '垃圾',
		};

		let filter = 'all';
		let items: AdminComment[] = [];

		function render() {
			const list = document.getElementById('comment-list')!;
			const shown = filter === 'all' ? items : items.filter((c) => c.status === filter);
			list.innerHTML = '';
			if (!shown.length) {
				list.innerHTML = '<p class="py-10 text-center text-sm text-zinc-400 dark:text-zinc-600">没有符合条件的评论</p>';
				return;
			}
			for (const c of shown) {
				const div = document.createElement('article');
				div.className =
					'rounded-2xl border border-zinc-200/80 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900';
				div.innerHTML = `
					<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
						<span class="font-semibold text-zinc-900 dark:text-zinc-100">${esc(c.authorName)}</span>
						<span class="rounded-full px-2 py-0.5 text-xs font-medium ${STATUS_STYLE[c.status] ?? ''}">${STATUS_LABEL[c.status] ?? c.status}</span>
						<time class="text-xs text-zinc-400 dark:text-zinc-600">${fmtDate(c.createdAt)}</time>
						${
							c.postSlug
								? `<a href="/blog/${c.postSlug}/" target="_blank" class="ml-auto text-xs text-zinc-400 transition-colors hover:text-brand-600 dark:hover:text-brand-400">于「${esc(c.postTitle ?? '')}」 ↗</a>`
								: '<span class="ml-auto text-xs text-zinc-400">文章已删除</span>'
						}
					</div>
					${c.parentId ? '<p class="mt-1 text-xs text-zinc-400 dark:text-zinc-600">↳ 回复评论 #' + c.parentId + '</p>' : ''}
					<p class="mt-2.5 text-sm leading-relaxed break-words text-zinc-600 dark:text-zinc-300">${esc(c.content)}</p>
					<div class="mt-3.5 flex gap-4 text-xs font-semibold">
						<button data-act="approve" data-id="${c.id}" class="text-emerald-600 transition-opacity hover:opacity-70 dark:text-emerald-400">通过</button>
						<button data-act="pending" data-id="${c.id}" class="text-amber-600 transition-opacity hover:opacity-70 dark:text-amber-400">撤下待审</button>
						<button data-act="spam" data-id="${c.id}" class="text-orange-600 transition-opacity hover:opacity-70 dark:text-orange-400">标记垃圾</button>
						<button data-act="delete" data-id="${c.id}" class="ml-auto text-zinc-400 transition-colors hover:text-rose-500">删除</button>
					</div>
				`;
				list.appendChild(div);
			}
		}

		async function load() {
			try {
				const res = await fetch('/api/admin/comments');
				if (res.status === 401) {
					window.location.href = '/admin/login';
					return;
				}
				const data = await res.json();
				items = data.items ?? [];
				render();
			} catch {
				document.getElementById('comment-list')!.innerHTML =
					'<p class="py-10 text-center text-sm text-zinc-400">加载失败</p>';
			}
		}

		// 筛选 Tab
		document.querySelectorAll('[data-filter]').forEach((btn) => {
			btn.addEventListener('click', () => {
				filter = (btn as HTMLElement).dataset.filter ?? 'all';
				document.querySelectorAll('[data-filter]').forEach((b) => {
					const active = b === btn;
					b.className = active
						? 'rounded-full border border-transparent bg-gradient-to-r from-brand-600 to-violet-600 text-white shadow-md shadow-brand-500/25 px-4 py-1.5 text-sm font-medium transition-all'
						: 'rounded-full border border-zinc-200 bg-white text-zinc-500 hover:border-zinc-300 hover:text-zinc-700 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200 px-4 py-1.5 text-sm font-medium transition-all';
				});
				render();
			});
		});

		// 审核操作（事件委托）
		document.getElementById('comment-list')?.addEventListener('click', async (e) => {
			const btn = (e.target as HTMLElement).closest('[data-act]') as HTMLButtonElement | null;
			if (!btn) return;
			const action = btn.dataset.act!;
			const id = Number(btn.dataset.id);
			if (action === 'delete' && !confirm('确定彻底删除这条评论？')) return;
			const res = await fetch('/api/admin/comments', {
				method: 'PUT',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ id, action }),
			});
			if (res.ok) {
				if (action === 'delete') items = items.filter((c) => c.id !== id);
				else {
					const target = items.find((c) => c.id === id);
					if (target) target.status = action;
				}
				render();
			}
		});

		load();
	</script>
</AdminLayout>
