---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdminPage } from '../../lib/auth';

export const prerender = false;

const redirect = await requireAdminPage(Astro.locals.runtime.env, Astro.request);
if (redirect) return redirect;
---

<AdminLayout title="站点设置">
	<div id="settings-root" class="mx-auto max-w-3xl">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<h1 class="text-2xl font-bold text-zinc-900 dark:text-white">站点设置</h1>
				<p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">前台首页 Hero 与「关于」页的文案在此编辑，保存后立即生效。</p>
			</div>
			<button
				type="button"
				id="save-btn"
				class="rounded-xl bg-gradient-to-r from-brand-600 to-violet-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-brand-500/25 transition-all hover:-translate-y-0.5"
			>
				保存设置
			</button>
		</div>

		<form id="settings-form" class="mt-6 space-y-6 pb-16" onsubmit="return false;">
			<!-- 首页 Hero -->
			<section class="rounded-2xl border border-zinc-200/80 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
				<h2 class="text-sm font-bold text-zinc-900 dark:text-white">首页 Hero</h2>
				<div class="mt-4 grid gap-4 sm:grid-cols-2">
					<div>
						<label class="block text-xs font-medium text-zinc-500 dark:text-zinc-400" for="f-hero-greeting">问候语</label>
						<input id="f-hero-greeting" type="text" class="mt-1.5 h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-sm text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500" />
					</div>
					<div>
						<label class="block text-xs font-medium text-zinc-500 dark:text-zinc-400" for="f-hero-name">名字（渐变高亮显示）</label>
						<input id="f-hero-name" type="text" class="mt-1.5 h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-sm text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500" />
					</div>
					<div>
						<label class="block text-xs font-medium text-zinc-500 dark:text-zinc-400" for="f-tagline-light">浅色主题口号（港区）</label>
						<input id="f-tagline-light" type="text" class="mt-1.5 h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-sm text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500" />
					</div>
					<div>
						<label class="block text-xs font-medium text-zinc-500 dark:text-zinc-400" for="f-tagline-dark">暗色主题口号（圣杯）</label>
						<input id="f-tagline-dark" type="text" class="mt-1.5 h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-sm text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500" />
					</div>
				</div>
				<div class="mt-4">
					<label class="block text-xs font-medium text-zinc-500 dark:text-zinc-400" for="f-hero-bio">首页简介（标题下方的一段话）</label>
					<textarea id="f-hero-bio" rows="4" class="mt-1.5 w-full resize-y rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 text-sm leading-relaxed text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500"></textarea>
				</div>
			</section>

			<!-- 关于页 -->
			<section class="rounded-2xl border border-zinc-200/80 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
				<h2 class="text-sm font-bold text-zinc-900 dark:text-white">关于页</h2>
				<div class="mt-4 space-y-4">
					<div>
						<label class="block text-xs font-medium text-zinc-500 dark:text-zinc-400" for="f-about-role">身份标语（头像下方一行）</label>
						<input id="f-about-role" type="text" class="mt-1.5 h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-sm text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500" />
					</div>
					<div>
						<label class="block text-xs font-medium text-zinc-500 dark:text-zinc-400" for="f-about-badges">标签（逗号分隔）</label>
						<input id="f-about-badges" type="text" placeholder="写代码, 做产品, 记录生活" class="mt-1.5 h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-sm text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500" />
					</div>
					<div>
						<label class="block text-xs font-medium text-zinc-500 dark:text-zinc-400" for="f-about-bio">简介</label>
						<textarea id="f-about-bio" rows="12" class="mt-1.5 w-full resize-y rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 text-sm leading-relaxed text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500"></textarea>
						<p class="mt-1.5 text-[11px] text-zinc-400 dark:text-zinc-600">段落之间用空行分隔；<code class="rounded bg-zinc-100 px-1 dark:bg-zinc-800">**文字**</code> 加粗；<code class="rounded bg-zinc-100 px-1 dark:bg-zinc-800">{name}</code> 会替换为上面的名字。</p>
					</div>
				</div>

				<!-- 时间线编辑 -->
				<div class="mt-6">
					<div class="flex items-center justify-between">
						<label class="text-xs font-medium text-zinc-500 dark:text-zinc-400">时间线「我的旅程」</label>
						<button
							type="button"
							id="tl-add-btn"
							class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-semibold text-zinc-600 transition-colors hover:border-brand-400 hover:text-brand-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-brand-500 dark:hover:text-brand-400"
						>
							+ 添加一段
						</button>
					</div>
					<div id="tl-list" class="mt-2.5 space-y-2.5"></div>
				</div>

				<!-- 联系卡片 -->
				<div class="mt-6 grid gap-4 sm:grid-cols-2">
					<div>
						<label class="block text-xs font-medium text-zinc-500 dark:text-zinc-400" for="f-contact-title">联系区标题</label>
						<input id="f-contact-title" type="text" class="mt-1.5 h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-sm text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500" />
					</div>
					<div>
						<label class="block text-xs font-medium text-zinc-500 dark:text-zinc-400" for="f-contact-email">联系邮箱（留空则隐藏邮件按钮）</label>
						<input id="f-contact-email" type="text" placeholder="you@example.com" class="mt-1.5 h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-sm text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500" />
					</div>
				</div>
				<div class="mt-4">
					<label class="block text-xs font-medium text-zinc-500 dark:text-zinc-400" for="f-contact-desc">联系区描述</label>
					<textarea id="f-contact-desc" rows="2" class="mt-1.5 w-full resize-y rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 text-sm leading-relaxed text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500"></textarea>
				</div>
			</section>
		</form>

		<div
			id="toast"
			class="pointer-events-none fixed right-8 bottom-8 z-50 rounded-lg px-4 py-2.5 text-sm font-medium text-white opacity-0 shadow-lg transition-all duration-300"
			aria-live="polite"
		>
		</div>
	</div>

	<script>
		interface TimelineItem {
			date: string;
			title: string;
			desc: string;
		}

		interface SiteSettings {
			heroGreeting: string;
			heroName: string;
			heroTaglineLight: string;
			heroTaglineDark: string;
			heroBio: string;
			aboutRole: string;
			aboutBadges: string[];
			aboutBio: string;
			aboutTimeline: TimelineItem[];
			aboutContactTitle: string;
			aboutContactDesc: string;
			aboutContactEmail: string;
		}

		const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

		const inputCls =
			'h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-sm text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500';

		/* ---------- 时间线动态行 ---------- */

		function addTimelineRow(item: TimelineItem = { date: '', title: '', desc: '' }) {
			const row = document.createElement('div');
			row.className = 'tl-row rounded-xl border border-zinc-200/80 bg-zinc-50/60 p-3 dark:border-zinc-800 dark:bg-zinc-800/30';
			row.innerHTML = `
				<div class="flex gap-2">
					<input class="tl-date ${inputCls}" style="max-width:7rem" placeholder="如 2026" value="${escapeAttr(item.date)}" />
					<input class="tl-title ${inputCls}" placeholder="标题，如 写下第一篇博客" value="${escapeAttr(item.title)}" />
					<button type="button" class="tl-del shrink-0 rounded-lg px-3 text-sm font-medium text-rose-500 transition-colors hover:bg-rose-50 dark:hover:bg-rose-500/10" title="删除这一行">删除</button>
				</div>
				<input class="tl-desc ${inputCls} mt-2" placeholder="描述（可选）" value="${escapeAttr(item.desc)}" />
			`;
			row.querySelector('.tl-del')?.addEventListener('click', () => row.remove());
			$('tl-list').appendChild(row);
		}

		function collectTimeline(): TimelineItem[] {
			return [...document.querySelectorAll('#tl-list .tl-row')].map((row) => ({
				date: (row.querySelector('.tl-date') as HTMLInputElement).value.trim(),
				title: (row.querySelector('.tl-title') as HTMLInputElement).value.trim(),
				desc: (row.querySelector('.tl-desc') as HTMLInputElement).value.trim(),
			}));
		}

		function escapeAttr(s: string): string {
			return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
		}

		/* ---------- 加载 / 保存 ---------- */

		function fill(id: string, value: string) {
			($(id) as HTMLInputElement).value = value;
		}

		async function load() {
			let data: SiteSettings;
			try {
				const res = await fetch('/api/admin/settings');
				if (res.status === 401) {
					window.location.href = '/admin/login';
					return;
				}
				data = await res.json();
			} catch {
				toast('加载失败，请刷新重试', true);
				return;
			}
			fill('f-hero-greeting', data.heroGreeting);
			fill('f-hero-name', data.heroName);
			fill('f-tagline-light', data.heroTaglineLight);
			fill('f-tagline-dark', data.heroTaglineDark);
			fill('f-hero-bio', data.heroBio);
			fill('f-about-role', data.aboutRole);
			fill('f-about-badges', data.aboutBadges.join(', '));
			fill('f-about-bio', data.aboutBio);
			fill('f-contact-title', data.aboutContactTitle);
			fill('f-contact-desc', data.aboutContactDesc);
			fill('f-contact-email', data.aboutContactEmail);
			for (const item of data.aboutTimeline) addTimelineRow(item);
		}

		async function save() {
			const btn = $('save-btn') as HTMLButtonElement;
			const payload: Record<string, unknown> = {
				heroGreeting: val('f-hero-greeting'),
				heroName: val('f-hero-name'),
				heroTaglineLight: val('f-tagline-light'),
				heroTaglineDark: val('f-tagline-dark'),
				heroBio: val('f-hero-bio'),
				aboutRole: val('f-about-role'),
				aboutBadges: val('f-about-badges'),
				aboutBio: val('f-about-bio'),
				aboutContactTitle: val('f-contact-title'),
				aboutContactDesc: val('f-contact-desc'),
				aboutContactEmail: val('f-contact-email'),
			};
			const timeline = collectTimeline().filter((t) => t.title);
			if (timeline.length) payload.aboutTimeline = timeline;

			btn.disabled = true;
			btn.textContent = '保存中…';
			try {
				const res = await fetch('/api/admin/settings', {
					method: 'PUT',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});
				const data = (await res.json()) as { error?: string };
				if (!res.ok) {
					toast(data.error || '保存失败', true);
					return;
				}
				toast('已保存，前台已更新');
			} catch {
				toast('网络错误，保存失败', true);
			} finally {
				btn.disabled = false;
				btn.textContent = '保存设置';
			}
		}

		function val(id: string): string {
			return ($(id) as HTMLInputElement).value;
		}

		function toast(msg: string, isError = false) {
			const el = $('toast');
			el.textContent = msg;
			el.className = el.className.replace(/bg-\S+/, isError ? 'bg-rose-500' : 'bg-emerald-500');
			el.classList.remove('opacity-0', 'translate-y-2');
			el.classList.add('opacity-100');
			window.setTimeout(() => {
				el.classList.remove('opacity-100');
				el.classList.add('opacity-0', 'translate-y-2');
			}, 2400);
		}

		$('tl-add-btn').addEventListener('click', () => addTimelineRow());
		$('save-btn').addEventListener('click', () => void save());
		void load();
	</script>
</AdminLayout>
