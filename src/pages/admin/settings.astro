---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdminPage } from '../../lib/auth';
import StyleControls from '../../components/admin/StyleControls.astro';

export const prerender = false;

const redirect = await requireAdminPage(Astro.locals.runtime.env, Astro.request);
if (redirect) return redirect;

const inputCls =
	'h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-sm text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500';
const textareaCls =
	'w-full resize-y rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 text-sm leading-relaxed text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500';
const labelCls = 'block text-xs font-medium text-zinc-500 dark:text-zinc-400';
---

<AdminLayout title="站点设置">
	<div id="settings-root" class="mx-auto max-w-3xl">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<h1 class="text-2xl font-bold text-zinc-900 dark:text-white">站点设置</h1>
				<p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">站点标题、Logo、站长信息与前台文案在此编辑；文案支持字体、颜色与换行，保存后立即生效。</p>
			</div>
			<button
				type="button"
				id="save-btn"
				class="rounded-xl bg-gradient-to-r from-brand-600 to-violet-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-brand-500/25 transition-all hover:-translate-y-0.5"
			>
				保存设置
			</button>
		</div>

		<form id="settings-form" class="mt-6 space-y-6 pb-16" onsubmit="return false;">
			<!-- 站点信息 -->
			<section class="rounded-2xl border border-zinc-200/80 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
				<h2 class="text-sm font-bold text-zinc-900 dark:text-white">站点信息</h2>
				<div class="mt-4 space-y-4">
					<div>
						<label class={labelCls} for="f-site-title">站点标题（浏览器标签、导航栏、RSS）</label>
						<input id="f-site-title" type="text" placeholder="如 Larson's Blog" class={`mt-1.5 ${inputCls}`} />
					</div>
					<div>
						<label class={labelCls} for="f-site-logo">站点 Logo（留空则显示标题首字母）</label>
						<div class="mt-1.5 flex items-center gap-3">
							<div class="relative flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-zinc-100 dark:bg-zinc-800" data-logo-preview>
								<span class="text-sm font-bold text-zinc-400 dark:text-zinc-500">–</span>
							</div>
							<input id="f-site-logo" type="text" placeholder="/media/uploads/… 或 https://…" class="h-10 min-w-0 flex-1 rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-xs text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500" />
							<div class="flex shrink-0 gap-2">
								<button
									type="button"
									data-upload="f-site-logo"
									class="rounded-lg border border-zinc-200 px-3 py-2 text-xs font-semibold text-zinc-600 transition-colors hover:border-brand-400 hover:text-brand-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-brand-500 dark:hover:text-brand-400"
								>
									上传
								</button>
								<button
									type="button"
									data-clear="f-site-logo"
									class="rounded-lg border border-zinc-200 px-3 py-2 text-xs font-semibold text-zinc-400 transition-colors hover:border-rose-300 hover:text-rose-500 dark:border-zinc-700"
								>
									清除
								</button>
							</div>
						</div>
						<p class="mt-1.5 text-[11px] text-zinc-400 dark:text-zinc-600">建议正方形图片；上传后存入 R2 媒体库。</p>
					</div>
				</div>
			</section>

			<!-- 站长信息 -->
			<section class="rounded-2xl border border-zinc-200/80 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
				<h2 class="text-sm font-bold text-zinc-900 dark:text-white">站长信息</h2>
				<div class="mt-4 space-y-4">
					<div data-style-group="heroName">
						<label class={labelCls} for="f-hero-name">站长名称（首页 Hero、关于页、页脚署名）</label>
						<input id="f-hero-name" type="text" class={`mt-1.5 ${inputCls}`} />
						<StyleControls field="heroName" />
					</div>
					<div>
						<label class={labelCls} for="f-owner-avatar">站长头像（留空则显示名称首字母）</label>
						<div class="mt-1.5 flex items-center gap-3">
							<div class="relative flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800" data-logo-preview>
								<span class="text-sm font-bold text-zinc-400 dark:text-zinc-500">–</span>
							</div>
							<input id="f-owner-avatar" type="text" placeholder="/media/uploads/… 或 https://…" class="h-10 min-w-0 flex-1 rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-xs text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500" />
							<div class="flex shrink-0 gap-2">
								<button
									type="button"
									data-upload="f-owner-avatar"
									class="rounded-lg border border-zinc-200 px-3 py-2 text-xs font-semibold text-zinc-600 transition-colors hover:border-brand-400 hover:text-brand-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-brand-500 dark:hover:text-brand-400"
								>
									上传
								</button>
								<button
									type="button"
									data-clear="f-owner-avatar"
									class="rounded-lg border border-zinc-200 px-3 py-2 text-xs font-semibold text-zinc-400 transition-colors hover:border-rose-300 hover:text-rose-500 dark:border-zinc-700"
								>
									清除
								</button>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 首页 Hero -->
			<section class="rounded-2xl border border-zinc-200/80 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
				<h2 class="text-sm font-bold text-zinc-900 dark:text-white">首页 Hero</h2>
				<div class="mt-4 space-y-4">
					<div data-style-group="heroGreeting">
						<label class={labelCls} for="f-hero-greeting">问候语</label>
						<input id="f-hero-greeting" type="text" class={`mt-1.5 ${inputCls}`} />
						<StyleControls field="heroGreeting" />
					</div>
					<div class="grid gap-4 sm:grid-cols-2">
						<div data-style-group="heroTaglineLight">
							<label class={labelCls} for="f-tagline-light">浅色主题口号（港区）</label>
							<input id="f-tagline-light" type="text" class={`mt-1.5 ${inputCls}`} />
							<StyleControls field="heroTaglineLight" />
						</div>
						<div data-style-group="heroTaglineDark">
							<label class={labelCls} for="f-tagline-dark">暗色主题口号（圣杯）</label>
							<input id="f-tagline-dark" type="text" class={`mt-1.5 ${inputCls}`} />
							<StyleControls field="heroTaglineDark" />
						</div>
					</div>
					<div data-style-group="heroBio">
						<label class={labelCls} for="f-hero-bio">首页简介（标题下方的一段话）</label>
						<textarea id="f-hero-bio" rows="4" class={`mt-1.5 ${textareaCls}`}></textarea>
						<StyleControls field="heroBio" multiline />
						<p class="mt-1.5 text-[11px] text-zinc-400 dark:text-zinc-600">回车换行；<code class="rounded bg-zinc-100 px-1 dark:bg-zinc-800">**文字**</code> 加粗。</p>
					</div>
				</div>
			</section>

			<!-- 关于页 -->
			<section class="rounded-2xl border border-zinc-200/80 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
				<h2 class="text-sm font-bold text-zinc-900 dark:text-white">关于页</h2>
				<div class="mt-4 space-y-4">
					<div data-style-group="aboutRole">
						<label class={labelCls} for="f-about-role">身份标语（头像下方一行）</label>
						<input id="f-about-role" type="text" class={`mt-1.5 ${inputCls}`} />
						<StyleControls field="aboutRole" />
					</div>
					<div>
						<label class={labelCls} for="f-about-badges">标签（逗号分隔）</label>
						<input id="f-about-badges" type="text" placeholder="写代码, 做产品, 记录生活" class={`mt-1.5 ${inputCls}`} />
					</div>
					<div data-style-group="aboutBio">
						<label class={labelCls} for="f-about-bio">简介</label>
						<textarea id="f-about-bio" rows="12" class={`mt-1.5 ${textareaCls}`}></textarea>
						<StyleControls field="aboutBio" multiline />
						<p class="mt-1.5 text-[11px] text-zinc-400 dark:text-zinc-600">空行分段、段内回车换行；<code class="rounded bg-zinc-100 px-1 dark:bg-zinc-800">**文字**</code> 加粗；<code class="rounded bg-zinc-100 px-1 dark:bg-zinc-800">&#123;name&#125;</code> 会替换为站长名称。</p>
					</div>
				</div>

				<!-- 时间线编辑 -->
				<div class="mt-6">
					<div class="flex items-center justify-between">
						<label class="text-xs font-medium text-zinc-500 dark:text-zinc-400">时间线「我的旅程」</label>
						<button
							type="button"
							id="tl-add-btn"
							class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-semibold text-zinc-600 transition-colors hover:border-brand-400 hover:text-brand-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-brand-500 dark:hover:text-brand-400"
						>
							+ 添加一段
						</button>
					</div>
					<div id="tl-list" class="mt-2.5 space-y-2.5"></div>
				</div>

				<!-- 联系卡片 -->
				<div class="mt-6 space-y-4">
					<div data-style-group="aboutContactTitle">
						<label class={labelCls} for="f-contact-title">联系区标题</label>
						<input id="f-contact-title" type="text" class={`mt-1.5 ${inputCls}`} />
						<StyleControls field="aboutContactTitle" />
					</div>
					<div data-style-group="aboutContactDesc">
						<label class={labelCls} for="f-contact-desc">联系区描述</label>
						<textarea id="f-contact-desc" rows="2" class={`mt-1.5 ${textareaCls}`}></textarea>
						<StyleControls field="aboutContactDesc" multiline />
						<p class="mt-1.5 text-[11px] text-zinc-400 dark:text-zinc-600">回车换行；<code class="rounded bg-zinc-100 px-1 dark:bg-zinc-800">**文字**</code> 加粗。</p>
					</div>
					<div>
						<label class={labelCls} for="f-contact-email">联系邮箱（留空则隐藏邮件按钮）</label>
						<input id="f-contact-email" type="text" placeholder="you@example.com" class={`mt-1.5 ${inputCls}`} />
					</div>
				</div>
			</section>
		</form>

		<!-- 隐藏的文件选择（Logo / 头像上传共用） -->
		<input id="img-file-input" type="file" accept="image/*" class="hidden" />

		<div
			id="toast"
			class="pointer-events-none fixed right-8 bottom-8 z-50 rounded-lg px-4 py-2.5 text-sm font-medium text-white opacity-0 shadow-lg transition-all duration-300"
			aria-live="polite"
		>
		</div>
	</div>

	<script>
		interface TimelineItem {
			date: string;
			title: string;
			desc: string;
		}

		interface StyledText {
			text: string;
			color: string;
			font: string;
		}

		interface SiteSettings {
			siteTitle: string;
			siteLogo: string;
			ownerAvatar: string;
			heroGreeting: StyledText;
			heroName: StyledText;
			heroTaglineLight: StyledText;
			heroTaglineDark: StyledText;
			heroBio: StyledText;
			aboutRole: StyledText;
			aboutBadges: string[];
			aboutBio: StyledText;
			aboutTimeline: TimelineItem[];
			aboutContactTitle: StyledText;
			aboutContactDesc: StyledText;
			aboutContactEmail: string;
		}

		const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

		const inputCls =
			'h-10 w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 text-sm text-zinc-900 outline-none focus:border-brand-400 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-white dark:focus:border-brand-500';

		const STYLED_FIELDS = [
			'heroGreeting',
			'heroName',
			'heroTaglineLight',
			'heroTaglineDark',
			'heroBio',
			'aboutRole',
			'aboutBio',
			'aboutContactTitle',
			'aboutContactDesc',
		] as const;

		/* ---------- 文案样式控件（字体 / 颜色）绑定 ---------- */

		interface StyleGroupState {
			get(): StyledText;
			set(value: StyledText): void;
		}

		const styleGroups: Partial<Record<(typeof STYLED_FIELDS)[number], StyleGroupState>> = {};

		for (const group of document.querySelectorAll<HTMLElement>('[data-style-group]')) {
			const field = group.dataset.styleGroup as (typeof STYLED_FIELDS)[number];
			const textEl = group.querySelector<HTMLInputElement | HTMLTextAreaElement>('input[type="text"], textarea');
			const colorInput = group.querySelector<HTMLInputElement>('[data-color-select]');
			const fontSelect = group.querySelector<HTMLSelectElement>('[data-font-select]');
			const resetBtn = group.querySelector<HTMLButtonElement>('[data-color-reset]');
			if (!textEl || !colorInput || !fontSelect) continue;

			let color = '';
			const sync = () => {
				colorInput.style.opacity = color ? '1' : '0.35';
			};
			colorInput.addEventListener('input', () => {
				color = colorInput.value;
				sync();
			});
			resetBtn?.addEventListener('click', () => {
				color = '';
				colorInput.value = '#1d5fb8';
				sync();
			});
			sync();

			styleGroups[field] = {
				get: () => ({ text: textEl.value, color, font: fontSelect.value }),
				set: (value) => {
					textEl.value = value.text;
					color = value.color || '';
					colorInput.value = color || '#1d5fb8';
					fontSelect.value = value.font || '';
					sync();
				},
			};
		}

		/* ---------- 图片字段（Logo / 头像）：预览 + 上传到 R2 + 清除 ---------- */

		function refreshPreview(inputId: string) {
			const input = $(inputId) as HTMLInputElement;
			const holder = input.closest('div')?.parentElement?.querySelector('[data-logo-preview]');
			if (!holder) return;
			const url = input.value.trim();
			holder.innerHTML = '';
			if (url) {
				const img = document.createElement('img');
				img.src = url;
				img.alt = '';
				img.className = 'h-full w-full object-cover';
				img.onerror = () => {
					holder.innerHTML = '<span class="text-sm font-bold text-rose-400">?</span>';
				};
				holder.appendChild(img);
			} else {
				holder.innerHTML = '<span class="text-sm font-bold text-zinc-400 dark:text-zinc-500">–</span>';
			}
		}

		async function uploadImage(file: File, inputId: string) {
			const form = new FormData();
			form.append('file', file);
			try {
				const res = await fetch('/api/admin/media', { method: 'POST', body: form });
				const data = (await res.json()) as { url?: string; error?: string };
				if (!res.ok || !data.url) {
					toast(data.error || '上传失败', true);
					return;
				}
				($(inputId) as HTMLInputElement).value = data.url;
				refreshPreview(inputId);
				toast('已上传，记得保存设置');
			} catch {
				toast('网络错误，上传失败', true);
			}
		}

		let pendingUploadTarget = '';
		document.querySelectorAll('[data-upload]').forEach((btn) => {
			btn.addEventListener('click', () => {
				pendingUploadTarget = (btn as HTMLElement).dataset.upload ?? '';
				$('img-file-input').click();
			});
		});
		document.querySelectorAll('[data-clear]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = (btn as HTMLElement).dataset.clear ?? '';
				($(id) as HTMLInputElement).value = '';
				refreshPreview(id);
			});
		});
		$('img-file-input').addEventListener('change', () => {
			const input = $('img-file-input') as HTMLInputElement;
			const file = input.files?.[0];
			if (file && pendingUploadTarget) void uploadImage(file, pendingUploadTarget);
			input.value = '';
		});
		for (const id of ['f-site-logo', 'f-owner-avatar']) {
			$(id).addEventListener('input', () => refreshPreview(id));
		}

		/* ---------- 时间线动态行 ---------- */

		function addTimelineRow(item: TimelineItem = { date: '', title: '', desc: '' }) {
			const row = document.createElement('div');
			row.className = 'tl-row rounded-xl border border-zinc-200/80 bg-zinc-50/60 p-3 dark:border-zinc-800 dark:bg-zinc-800/30';
			row.innerHTML = `
				<div class="flex gap-2">
					<input class="tl-date ${inputCls}" style="max-width:7rem" placeholder="如 2026" value="${escapeAttr(item.date)}" />
					<input class="tl-title ${inputCls}" placeholder="标题，如 写下第一篇博客" value="${escapeAttr(item.title)}" />
					<button type="button" class="tl-del shrink-0 rounded-lg px-3 text-sm font-medium text-rose-500 transition-colors hover:bg-rose-50 dark:hover:bg-rose-500/10" title="删除这一行">删除</button>
				</div>
				<input class="tl-desc ${inputCls} mt-2" placeholder="描述（可选）" value="${escapeAttr(item.desc)}" />
			`;
			row.querySelector('.tl-del')?.addEventListener('click', () => row.remove());
			$('tl-list').appendChild(row);
		}

		function collectTimeline(): TimelineItem[] {
			return [...document.querySelectorAll('#tl-list .tl-row')].map((row) => ({
				date: (row.querySelector('.tl-date') as HTMLInputElement).value.trim(),
				title: (row.querySelector('.tl-title') as HTMLInputElement).value.trim(),
				desc: (row.querySelector('.tl-desc') as HTMLInputElement).value.trim(),
			}));
		}

		function escapeAttr(s: string): string {
			return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
		}

		/* ---------- 加载 / 保存 ---------- */

		function fill(id: string, value: string) {
			($(id) as HTMLInputElement).value = value;
		}

		async function load() {
			let data: SiteSettings;
			try {
				const res = await fetch('/api/admin/settings');
				if (res.status === 401) {
					window.location.href = '/admin/login';
					return;
				}
				data = await res.json();
			} catch {
				toast('加载失败，请刷新重试', true);
				return;
			}
			fill('f-site-title', data.siteTitle);
			fill('f-site-logo', data.siteLogo);
			fill('f-owner-avatar', data.ownerAvatar);
			fill('f-about-badges', data.aboutBadges.join(', '));
			fill('f-contact-email', data.aboutContactEmail);
			for (const field of STYLED_FIELDS) {
				styleGroups[field]?.set(data[field]);
			}
			refreshPreview('f-site-logo');
			refreshPreview('f-owner-avatar');
			for (const item of data.aboutTimeline) addTimelineRow(item);
		}

		async function save() {
			const btn = $('save-btn') as HTMLButtonElement;
			const payload: Record<string, unknown> = {
				siteTitle: val('f-site-title'),
				siteLogo: val('f-site-logo'),
				ownerAvatar: val('f-owner-avatar'),
				aboutBadges: val('f-about-badges'),
				aboutContactEmail: val('f-contact-email'),
			};
			for (const field of STYLED_FIELDS) {
				payload[field] = styleGroups[field]?.get();
			}
			const timeline = collectTimeline().filter((t) => t.title);
			if (timeline.length) payload.aboutTimeline = timeline;

			btn.disabled = true;
			btn.textContent = '保存中…';
			try {
				const res = await fetch('/api/admin/settings', {
					method: 'PUT',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});
				const data = (await res.json()) as { error?: string };
				if (!res.ok) {
					toast(data.error || '保存失败', true);
					return;
				}
				toast('已保存，前台已更新');
			} catch {
				toast('网络错误，保存失败', true);
			} finally {
				btn.disabled = false;
				btn.textContent = '保存设置';
			}
		}

		function val(id: string): string {
			return ($(id) as HTMLInputElement).value;
		}

		function toast(msg: string, isError = false) {
			const el = $('toast');
			el.textContent = msg;
			el.classList.remove('bg-emerald-500', 'bg-rose-500');
			el.classList.add(isError ? 'bg-rose-500' : 'bg-emerald-500');
			el.classList.remove('opacity-0', 'translate-y-2');
			el.classList.add('opacity-100');
			window.setTimeout(() => {
				el.classList.remove('opacity-100');
				el.classList.add('opacity-0', 'translate-y-2');
			}, 2400);
		}

		$('tl-add-btn').addEventListener('click', () => addTimelineRow());
		$('save-btn').addEventListener('click', () => void save());
		void load();
	</script>
</AdminLayout>
