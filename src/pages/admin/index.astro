---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdminPage } from '../../lib/auth';

export const prerender = false;

const redirect = await requireAdminPage(Astro.locals.runtime.env, Astro.request);
if (redirect) return redirect;
---

<AdminLayout title="仪表盘">
	<div id="dashboard" class="mx-auto max-w-5xl">
		<h1 class="text-2xl font-bold text-zinc-900 dark:text-white">仪表盘</h1>

		<!-- 统计卡片 -->
		<div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
			{
				[
					{ key: 'views', label: '总浏览量', icon: 'M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0', gradient: 'from-sky-500 to-blue-600' },
					{ key: 'likes', label: '总点赞数', icon: 'M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z', gradient: 'from-rose-500 to-pink-600' },
					{ key: 'posts', label: '文章数', icon: 'M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5zM14 2v6h6', gradient: 'from-emerald-500 to-teal-600' },
					{ key: 'comments', label: '评论数', icon: 'M7.9 20A9 9 0 1 0 4 16.1L2 22Z', gradient: 'from-amber-500 to-orange-600' },
				].map((card) => (
					<div class="rounded-2xl border border-zinc-200/80 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
						<div class="flex items-center justify-between">
							<span class={`flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br ${card.gradient} text-white shadow-md`}>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
									<path d={card.icon} />
								</svg>
							</span>
						</div>
						<p class="mt-3 text-2xl font-bold text-zinc-900 dark:text-white" data-stat={card.key}>–</p>
						<p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-500">{card.label}</p>
					</div>
				))
			}
		</div>

		<!-- 浏览趋势（CSS 柱状图） + 热门文章 -->
		<div class="mt-6 grid gap-6 lg:grid-cols-2">
			<div class="rounded-2xl border border-zinc-200/80 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
				<h2 class="text-sm font-bold text-zinc-900 dark:text-white">近 14 天浏览趋势</h2>
				<div id="trend-chart" class="mt-4 flex h-36 items-end gap-1"></div>
				<div id="trend-labels" class="mt-2 flex gap-1 text-[9px] text-zinc-400 dark:text-zinc-600"></div>
			</div>
			<div class="rounded-2xl border border-zinc-200/80 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
				<h2 class="text-sm font-bold text-zinc-900 dark:text-white">热门文章</h2>
				<ol id="hot-posts" class="mt-4 space-y-2.5 text-sm">
					<li class="text-zinc-400 dark:text-zinc-600">加载中…</li>
				</ol>
			</div>
		</div>
	</div>

	<script>
		const fmt = (n: number) => (n >= 10000 ? (n / 10000).toFixed(1) + ' 万' : String(n));

		void (async () => {
			let data: {
				posts: { total: number; published: number };
				comments: { total: number; pending: number };
				likes: number;
				views: number;
				trend: { date: string; count: number }[];
				hot: { slug: string; title: string; views: number; likes: number }[];
			};
			try {
				const res = await fetch('/api/admin/stats');
				if (res.status === 401) {
					window.location.href = '/admin/login';
					return;
				}
				data = await res.json();
			} catch {
				return;
			}

			const setText = (key: string, value: string) => {
				const el = document.querySelector(`[data-stat="${key}"]`);
				if (el) el.textContent = value;
			};
			setText('views', fmt(data.views));
			setText('likes', fmt(data.likes));
			setText('posts', String(data.posts.total));
			setText('comments', String(data.comments.total));

			// 趋势柱状图
			const chart = document.getElementById('trend-chart');
			const labels = document.getElementById('trend-labels');
			if (chart && labels) {
				const byDate = new Map(data.trend.map((t) => [t.date, t.count]));
				const days: { date: string; count: number }[] = [];
				for (let i = 13; i >= 0; i--) {
					const d = new Date(Date.now() - i * 86400_000).toISOString().slice(0, 10);
					days.push({ date: d, count: byDate.get(d) ?? 0 });
				}
				const max = Math.max(1, ...days.map((d) => d.count));
				for (const day of days) {
					const bar = document.createElement('div');
					bar.className =
						'group relative flex-1 rounded-t-sm bg-gradient-to-t from-brand-500/80 to-violet-400/80 transition-all hover:from-brand-500 hover:to-violet-400';
					bar.style.height = `${Math.max(3, (day.count / max) * 100)}%`;
					bar.title = `${day.date.slice(5)} · ${day.count} 次浏览`;
					chart.appendChild(bar);
					const label = document.createElement('span');
					label.className = 'flex-1 text-center';
					label.textContent = day.date.slice(8);
					labels.appendChild(label);
				}
			}

			// 热门文章
			const hot = document.getElementById('hot-posts');
			if (hot) {
				hot.innerHTML = '';
				if (!data.hot.length) {
					hot.innerHTML = '<li class="text-zinc-400 dark:text-zinc-600">暂无数据</li>';
				}
				for (const [i, p] of data.hot.entries()) {
					const li = document.createElement('li');
					li.className = 'flex items-center gap-3';
					li.innerHTML = `
						<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md ${i < 3 ? 'bg-gradient-to-br from-brand-600 to-sky-500 text-white' : 'bg-zinc-100 text-zinc-400 dark:bg-zinc-800 dark:text-zinc-500'} text-xs font-bold">${i + 1}</span>
						<a href="/blog/${p.slug}/" target="_blank" class="flex-1 truncate font-medium text-zinc-700 transition-colors hover:text-brand-600 dark:text-zinc-300 dark:hover:text-amber-300">${p.title.replace(/</g, '&lt;')}</a>
						<span class="shrink-0 text-xs text-zinc-400 dark:text-zinc-600">${p.views} 浏览 · ${p.likes} 赞</span>
					`;
					hot.appendChild(li);
				}
			}
		})();
	</script>
</AdminLayout>
