---
import BaseLayout from '../layouts/BaseLayout.astro';
import { friendLinks } from '../data/links';


export const prerender = false;
---

<BaseLayout title="友链" description="我常逛的站点与朋友们">
	<section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
		<header class="reveal is-visible">
			<h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
				友链
			</h1>
			<p class="mt-3 max-w-xl text-zinc-500 dark:text-zinc-400">
				一些我常逛的站点与推荐资源。如果你也有不错的博客，欢迎交换友链。
			</p>
		</header>

		<div class="mt-10 grid gap-5 sm:grid-cols-2">
			{
				friendLinks.map((link, i) => (
					<a
						href={link.url}
						target="_blank"
						rel="noopener noreferrer"
						class="reveal group flex items-center gap-4 rounded-2xl border border-zinc-200/80 bg-white p-5 transition-all hover:-translate-y-1 hover:border-brand-300/60 hover:shadow-xl hover:shadow-brand-500/10 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-amber-500/60/40"
						style={`transition-delay:${Math.min(i, 5) * 60}ms`}
					>
						<span
							class:list={[
								'flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-lg font-bold text-white shadow-lg',
								link.gradient,
							]}
							aria-hidden="true"
						>
							{link.name.charAt(0)}
						</span>
						<span class="min-w-0 flex-1">
							<span class="flex items-center gap-1.5 font-bold text-zinc-900 transition-colors group-hover:text-brand-600 dark:text-white dark:group-hover:text-amber-300">
								{link.name}
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-zinc-300 transition-all group-hover:text-brand-500 dark:text-zinc-600" aria-hidden="true">
									<path d="M7 17 17 7" />
									<path d="M7 7h10v10" />
								</svg>
							</span>
							<span class="mt-1 line-clamp-2 block text-sm text-zinc-500 dark:text-zinc-400">
								{link.description}
							</span>
						</span>
					</a>
				))
			}
		</div>

		<!-- 交换友链提示 -->
		<div
			class="reveal mt-12 rounded-2xl border border-dashed border-zinc-300 bg-white/40 p-8 text-center dark:border-zinc-700 dark:bg-zinc-900/40"
		>
			<p class="text-sm font-medium text-zinc-600 dark:text-zinc-300">
				🔗 想交换友链？
			</p>
			<p class="mt-2 text-xs leading-relaxed text-zinc-400 dark:text-zinc-500">
				通过社交媒体联系我，附上你的站点名称、链接和一句简介即可。
			</p>
		</div>
	</section>
</BaseLayout>
