---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, AUTHOR_NAME } from '../consts';

export const prerender = true;
---

<BaseLayout title={`关于我 · ${SITE_TITLE}`} description={`关于 ${AUTHOR_NAME}：热爱技术与分享的开发者`}>
	<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
		<!-- 头部 -->
		<header class="reveal is-visible flex flex-col items-center text-center">
			<div
				class="flex h-24 w-24 items-center justify-center rounded-full bg-gradient-to-br from-brand-500 via-violet-500 to-fuchsia-500 text-3xl font-bold text-white shadow-xl shadow-brand-500/25"
				aria-hidden="true"
			>
				L
			</div>
			<h1 class="mt-6 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
				你好，我是<span class="text-gradient">{AUTHOR_NAME}</span>
			</h1>
			<p class="mt-3 max-w-md text-zinc-500 dark:text-zinc-400">
				开发者 · 写字的人 · 终身学习者
			</p>
			<div class="mt-5 flex flex-wrap justify-center gap-2">
				{
					['写代码', '做产品', '记录生活', '开源爱好者'].map((label) => (
						<span class="rounded-full bg-zinc-100 px-3.5 py-1 text-xs font-medium text-zinc-500 dark:bg-zinc-800/80 dark:text-zinc-400">
							{label}
						</span>
					))
				}
			</div>
		</header>

		<!-- 简介 -->
		<div class="prose prose-zinc reveal dark:prose-invert mt-14">
			<p>
				我是 {AUTHOR_NAME}，一名热爱技术与分享的开发者。平时喜欢研究新工具、折腾各种小项目，也乐于把踩过的坑整理成文章，分享给遇到同样问题的人。
			</p>
			<p>
				这个博客是我的数字自留地，主要记录三类内容：<strong>技术笔记</strong>，梳理我在学习和开发过程中的思路与解决方案；<strong>项目复盘</strong>，总结每次实践的收获与不足；<strong>生活随想</strong>，让这个站点不只是冷冰冰的技术文档。
			</p>
			<p>
				我始终相信，写作是最好的学习方式之一。把一件事讲清楚，远比把它做出来更难，也更有价值。因此我会尽量把每篇文章写得通俗易懂，希望能帮到你，哪怕只是一点点。
			</p>
			<p>
				工作之外，我喜欢阅读、跑步和摄影——虽然水平都一般，但足够让生活保持新鲜感。如果你对站点的某篇文章有疑问，或者想和我交流任何话题，欢迎随时给我发邮件或在社交网络上找我。你的每一条反馈，都会成为我持续写作的动力。
			</p>
		</div>

		<!-- 时间线 -->
		<section class="reveal mt-14">
			<h2 class="text-xl font-bold text-zinc-900 dark:text-white">我的旅程</h2>
			<ol class="mt-6 space-y-0">
				{
					[
						{ date: '2021', title: '写下第一篇博客', desc: '从一篇笨拙的笔记开始，养成记录的习惯。' },
						{ date: '2022', title: '搭建独立站点', desc: '告别平台托管，拥有完全属于自己的数字空间。' },
						{ date: '2024', title: '找到趁手的工具链', desc: '打磨写作工作流，让专注回归内容本身。' },
						{ date: '2026', title: '博客 2.0 改版', desc: '全新视觉、暗色模式、全文搜索，把站点做成自己喜欢的样子。' },
					].map((item, i, arr) => (
						<li class="relative flex gap-5 pb-8">
							{i < arr.length - 1 && (
								<span class="absolute top-5 left-[0.6rem] h-full w-px bg-zinc-200 dark:bg-zinc-800" aria-hidden="true" />
							)}
							<span class="relative mt-1.5 h-3 w-3 shrink-0 rounded-full border-2 border-brand-500 bg-zinc-50 dark:bg-zinc-950" aria-hidden="true" />
							<div>
								<p class="font-mono text-xs font-semibold tracking-wider text-brand-600 dark:text-brand-400">{item.date}</p>
								<p class="mt-1 font-semibold text-zinc-900 dark:text-white">{item.title}</p>
								<p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">{item.desc}</p>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<!-- 联系 -->
		<div
			class="reveal mt-14 rounded-3xl border border-zinc-200/70 bg-gradient-to-br from-brand-50/80 to-fuchsia-50/60 p-8 text-center dark:border-zinc-800/70 dark:from-brand-900/20 dark:to-fuchsia-900/10"
		>
			<h2 class="text-lg font-bold text-zinc-900 dark:text-white">想和我聊聊？</h2>
			<p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
				无论是技术交流、合作意向，还是单纯打个招呼，都欢迎随时联系。
			</p>
			<div class="mt-5 flex flex-wrap items-center justify-center gap-3">
				<a
					href="mailto:935636808@qq.com"
					class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-600 to-violet-600 px-6 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand-500/30 transition-all hover:-translate-y-0.5 hover:shadow-xl"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="h-4 w-4"
						aria-hidden="true"
					>
						<rect width="20" height="16" x="2" y="4" rx="2"></rect>
						<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
					</svg>
					给我发邮件
				</a>
				<a
					href="/blog"
					class="inline-flex items-center gap-2 rounded-full border border-zinc-300 px-6 py-2.5 text-sm font-semibold text-zinc-700 transition-all hover:-translate-y-0.5 hover:border-zinc-400 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500"
				>
					先去看看博客
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
