---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb } from '../lib/db';
import { getSiteSettings, renderAboutParagraph, renderMultiline, styledStyle } from '../lib/settings';

export const prerender = false;

const db = getDb(Astro);
const site = await getSiteSettings(Astro, db);
const avatarLetter = [...site.heroName.text.trim()][0]?.toUpperCase() ?? 'L';
const bioParagraphs = site.aboutBio.text
	.split(/\n{2,}/)
	.map((p) => p.trim())
	.filter(Boolean)
	.map((p) => renderAboutParagraph(p, site.heroName.text));
---

<BaseLayout title="关于我" description={`关于 ${site.heroName.text}：热爱技术与分享的开发者`}>
	<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
		<!-- 头部 -->
		<header class="reveal is-visible flex flex-col items-center text-center">
			{
				site.ownerAvatar ? (
					<img
						src={site.ownerAvatar}
						alt={site.heroName.text}
						class="h-24 w-24 rounded-full object-cover shadow-xl shadow-brand-500/25"
						width="96"
						height="96"
					/>
				) : (
					<div
						class="flex h-24 w-24 items-center justify-center rounded-full bg-gradient-to-br from-brand-600 via-sky-500 to-cyan-400 text-3xl font-bold text-white shadow-xl shadow-brand-500/25"
						aria-hidden="true"
					>
						{avatarLetter}
					</div>
				)
			}
			<h1 class="mt-6 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
				<span style={styledStyle(site.heroGreeting)}>{site.heroGreeting.text}</span><span class:list={[!site.heroName.color && 'text-gradient']} style={styledStyle(site.heroName)}>{site.heroName.text}</span>
			</h1>
			<p class="mt-3 max-w-md text-zinc-500 dark:text-zinc-400" style={styledStyle(site.aboutRole)}>
				{site.aboutRole.text}
			</p>
			<div class="mt-5 flex flex-wrap justify-center gap-2">
				{
					site.aboutBadges.map((label) => (
						<span class="rounded-full bg-zinc-100 px-3.5 py-1 text-xs font-medium text-zinc-500 dark:bg-zinc-800/80 dark:text-zinc-400">
							{label}
						</span>
					))
				}
			</div>
		</header>

		<!-- 简介 -->
		<div class="prose prose-zinc reveal dark:prose-invert mt-14" style={styledStyle(site.aboutBio)}>
			{bioParagraphs.map((html) => <p set:html={html} />)}
		</div>

		<!-- 时间线 -->
		{
			site.aboutTimeline.length > 0 && (
				<section class="reveal mt-14">
					<h2 class="text-xl font-bold text-zinc-900 dark:text-white">我的旅程</h2>
					<ol class="mt-6 space-y-0">
						{site.aboutTimeline.map((item, i, arr) => (
							<li class="relative flex gap-5 pb-8">
								{i < arr.length - 1 && (
									<span class="absolute top-5 left-[0.6rem] h-full w-px bg-zinc-200 dark:bg-zinc-800" aria-hidden="true" />
								)}
								<span class="relative mt-1.5 h-3 w-3 shrink-0 rounded-full border-2 border-brand-500 bg-zinc-50 dark:bg-zinc-950" aria-hidden="true" />
								<div>
									<p class="font-mono text-xs font-semibold tracking-wider text-brand-600 dark:text-amber-400">{item.date}</p>
									<p class="mt-1 font-semibold text-zinc-900 dark:text-white">{item.title}</p>
									<p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">{item.desc}</p>
								</div>
							</li>
						))}
					</ol>
				</section>
			)
		}

		<!-- 联系 -->
		<div
			class="reveal mt-14 rounded-3xl border border-zinc-200/70 bg-gradient-to-br from-brand-50/80 to-fuchsia-50/60 p-8 text-center dark:border-zinc-800/70 dark:from-brand-900/20 dark:to-fuchsia-900/10"
		>
			<h2 class="text-lg font-bold text-zinc-900 dark:text-white" style={styledStyle(site.aboutContactTitle)}>{site.aboutContactTitle.text}</h2>
			<p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400" style={styledStyle(site.aboutContactDesc)} set:html={renderMultiline(site.aboutContactDesc)}>
			</p>
			<div class="mt-5 flex flex-wrap items-center justify-center gap-3">
				{
					site.aboutContactEmail && (
						<a
							href={`mailto:${site.aboutContactEmail}`}
							class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-600 to-sky-500 px-6 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand-500/30 transition-all hover:-translate-y-0.5 hover:shadow-xl"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="h-4 w-4"
								aria-hidden="true"
							>
								<rect width="20" height="16" x="2" y="4" rx="2"></rect>
								<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
							</svg>
							给我发邮件
						</a>
					)
				}
				<a
					href="/blog"
					class="inline-flex items-center gap-2 rounded-full border border-zinc-300 px-6 py-2.5 text-sm font-semibold text-zinc-700 transition-all hover:-translate-y-0.5 hover:border-zinc-400 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500"
				>
					先去看看博客
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
